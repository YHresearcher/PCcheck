    <system:String x:Key="Sum.FreeSpaceWarn"> Cảnh báo: ổ chứa hồ sơ còn {0:0} MB trống.</system:String>

    <!-- Nút popup riêng của app -->
    <system:String x:Key="Dialog.Ok">Đã hiểu</system:String>
