    <system:String x:Key="Dash.Row.Mic">Microphone</system:String>
    <system:String x:Key="Dash.Row.Ports">Cổng kết nối</system:String>
    <system:String x:Key="Dash.Row.Visual">Ngoại quan</system:String>
    <system:String x:Key="Dash.Status.Pass">Đạt</system:String>
    <system:String x:Key="Dash.Status.Warn">Cảnh báo</system:String>
    <system:String x:Key="Dash.Status.Fail">Có lỗi</system:String>
    <system:String x:Key="Dash.Status.Untried">Chưa thử</system:String>
