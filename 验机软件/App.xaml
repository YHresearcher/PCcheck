<Application x:Class="YanJi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Không tự tạo MainWindow nữa: OnStartup tự hiện SplashWindow rồi mới tạo
         MainWindow, để màn hình chờ logo/thương hiệu hiện trong lúc tải module. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题令牌字典：占位用浅色，启动时由 ThemeManager 按设置替换 -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <!-- 常驻控件样式：全部 DynamicResource 引用令牌 -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
