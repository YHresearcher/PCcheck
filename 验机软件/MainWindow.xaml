<Window x:Class="YanJi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="An Tâm Check" Width="1536" Height="1024"
        MinWidth="940" MinHeight="680"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="/Fonts/#Be Vietnam Pro, Segoe UI, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Dải cam thương hiệu An Tâm trên cùng ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

        <!-- Compact utility strip: thương hiệu hiển thị duy nhất trong sidebar. -->
        <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="{DynamicResource Shell.StopHeavy}" Click="OnStopAllHeavyTestsClick" Padding="10,4"
                        Margin="0,0,12,0"
                        ToolTip="{DynamicResource Shell.StopHeavyTip}"/>
                <Button x:Name="LangButton" Content="🇬🇧" Click="OnLangButtonClick" Padding="10,4"
                        Margin="0,0,12,0" FontWeight="SemiBold" FontFamily="Segoe UI Emoji" FontSize="16"
                        ToolTip="{DynamicResource Shell.LangTip}"/>
                <TextBlock Text="☀" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeSwitch}"
                              ToolTip="{DynamicResource Shell.ThemeTip}"
                              Checked="OnThemeSwitch" Unchecked="OnThemeSwitch"/>
                <TextBlock Text="🌙" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Thanh wizard: chỉ hiện khi vào chế độ kiểm tra tập trung (Dashboard
             bấm Bắt đầu / Tiếp tục). Menu bên trái bị khóa lúc này để mỗi lần chỉ
             có 1 bài test chính, tránh thao tác nhầm; nút Dừng tất cả kiểm tra luôn hiện
             để không bị kẹt trong wizard. ═══ -->
        <Border x:Name="WizardBar" Grid.Row="2" Background="{DynamicResource SubtleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,6" Visibility="Collapsed">
            <!-- Nút wizard dùng style Button mặc định (nổi 3D kiểu Mac), không còn
                 style riêng — style WizardBarButton cũ đã bỏ vì trùng với mặc định. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Wizard.Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="WizardBackButton" Content="{DynamicResource Wizard.Back}" Click="OnWizardBackClick" Margin="16,0,0,0"/>
                <Button x:Name="WizardNextButton" Content="{DynamicResource Wizard.Next}" Click="OnWizardNextClick" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource Wizard.StopHeavy}" Click="OnWizardStopClick" Margin="8,0,0,0"/>
                <Button Content="{DynamicResource Wizard.Exit}" Click="OnWizardExitClick" Margin="8,0,0,0"
                        ToolTip="{DynamicResource Wizard.ExitTip}"/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左导航 + 内容 ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="274"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：导航项由 MainWindow.xaml.cs 按 plugins/ 目录实有插件动态生成。
                 完成态圆点约定：ListBoxItem 内容 = Grid(圆点 Ellipse + 对勾 TextBlock 默认 Collapsed) + 名称，
                 圆点/对勾登记进 _navDots（终点页插件用 Collapsed 占位圆点保持文字对齐）。
                 模块通过约定：页面实现 IModulePage 并触发 PassChanged(true) → 圆点变绿并自动跳到下一个
                 未完成模块；没有下一个时在导航底部显示「全部验机项目已完成」（AllDoneHint）。
                 插件增删见「插件管理」按钮（zip 导入即载；删除/覆盖走待处理操作 + 自动重启）。 -->
            <Border Grid.Column="0" Background="{DynamicResource SubtleBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- NavList giữ lại nhưng ẩn: wizard, tự nhảy bài, chấm trạng thái
                         và import plugin vẫn dùng nó làm trạng thái chọn; chỉ bỏ phần
                         hiển thị "Danh sách bài test" khỏi sidebar theo yêu cầu. -->
                    <ListBox x:Name="NavList" SelectionChanged="OnNavSelect"
                             BorderThickness="0" Background="Transparent" Visibility="Collapsed"/>
                    <StackPanel DockPanel.Dock="Top" Margin="14,20,14,14">
                        <!-- Tên app mới, một dòng ngang: "An Tâm" + logo Windows
                             (4 ô vuông cam vẽ bằng UniformGrid 2x2) + "Check" —
                             chữ và logo đều màu cam, font Be Vietnam Pro như website.
                             Mascot dời xuống cuối sidebar (xem SidebarMascot). -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                    VerticalAlignment="Center">
                            <TextBlock Text="An Tâm" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <UniformGrid Columns="2" Rows="2" Width="20" Height="20"
                                         Margin="8,0" VerticalAlignment="Center">
                                <Rectangle Fill="{DynamicResource AccentBrush}" Margin="0,0,1.5,1.5"/>
                                <Rectangle Fill="{DynamicResource AccentBrush}" Margin="1.5,0,0,1.5"/>
                                <Rectangle Fill="{DynamicResource AccentBrush}" Margin="0,1.5,1.5,0"/>
                                <Rectangle Fill="{DynamicResource AccentBrush}" Margin="1.5,1.5,0,0"/>
                            </UniformGrid>
                            <TextBlock Text="Check" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="NavOverview" Click="SidebarOverview_Click"
                                Style="{StaticResource SidebarNavButton}"
                                FontSize="15" FontWeight="SemiBold"
                                Background="{DynamicResource NavSelectedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/14_home_orange.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.Overview}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavInspection" Click="SidebarInspection_Click"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/15_search_gray.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.Inspection}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavReport" Click="SidebarReport_Click"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/16_bar_chart_gray.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.Report}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Nút Giới thiệu: nút nổi 3D bo 18 kiểu Mac (khác 3 nút phẳng
                             trên), mở popup thông tin shop — không dùng UI mặc định Windows. -->
                        <Button x:Name="NavAbout" Click="SidebarAbout_Click"
                                Style="{StaticResource RaisedButton18}"
                                FontSize="14" Padding="14,11" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/17_info_gray.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.About}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,17">
                        <!-- Mascot ở cuối sidebar, to (~200px), lấp khoảng trống dưới
                             nút Giới thiệu; màn hình thấp thì ẩn (AdjustSidebarForHeight). -->
                        <Image x:Name="SidebarMascot" Source="pack://application:,,,/Assets/mascot-sidebar-2026.png"
                               Width="200" Height="200" Stretch="Uniform" Margin="0,0,0,10"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="AllDoneHint" Text="{DynamicResource Shell.AllDone}"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock Text="{DynamicResource Shell.Footer}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容区：页面实例常驻，切换不丢核对状态 -->
            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
