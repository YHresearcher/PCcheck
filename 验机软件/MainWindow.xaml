<Window x:Class="YanJi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="An Tâm PC Test" Width="980" Height="720"
        MinWidth="880" MinHeight="640"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Dải cam thương hiệu An Tâm trên cùng ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

        <!-- ═══ 顶栏：logo + 应用名 + 右侧 插件管理 + 主题开关 ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource SubtleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,8">
            <!-- Top bar chia 2 cột (trái co giãn + phải tự rộng) để khi khung hẹp
                 thì chữ bên trái tự xuống dòng thay vì chèn lên nút bên phải như trước
                 (trước đây 2 StackPanel cùng nằm 1 ô Grid, không có cột, nên hẹp là chồng nhau).
                 Cột chữ cũng là Grid (logo Auto + chữ *) chứ không phải StackPanel ngang,
                 vì StackPanel ngang đo chữ với chiều rộng vô hạn nên TextWrapping không có tác dụng. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="pack://application:,,,/Assets/logo-antam.png"
                           Width="36" Height="36" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="An Tâm PC Test" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Công cụ kiểm tra PC/ Laptop cũ" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Vi tính An Tâm | Chuyên máy đã qua sử dụng, chuẩn doanh nghiệp" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Dừng tất cả test nặng" Click="OnStopAllHeavyTestsClick" Padding="12,4" Margin="0,0,12,0"
                            ToolTip="Dừng thật Prime95 / FurMark / đo tốc độ ổ (kill có kiểm chứng, không chỉ dừng giao diện). Nếu còn tiến trình sống sẽ báo rõ tên để kiểm tra Task Manager."/>
                    <Button Content="Quản lý Module" Click="OnPluginManagerClick" Padding="12,4" Margin="0,0,12,0"
                            ToolTip="Xem / xóa các module đã cài, hoặc nhập gói module dạng zip (module mới nhập là chạy ngay; xóa / ghi đè sẽ tự khởi động lại để hoàn tất)"/>
                    <TextBlock Text="☀" FontSize="14" Margin="0,0,4,0"/>
                    <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeSwitch}"
                                  ToolTip="Đổi giao diện tối / sáng"
                                  Checked="OnThemeSwitch" Unchecked="OnThemeSwitch"/>
                    <TextBlock Text="🌙" FontSize="14" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Thanh wizard: chỉ hiện khi vào chế độ kiểm tra tập trung (Dashboard
             bấm Bắt đầu / Tiếp tục). Menu bên trái bị khóa lúc này để mỗi lần chỉ
             có 1 bài test chính, tránh thao tác nhầm; nút Thoát wizard luôn hiện
             để không bị kẹt trong wizard. ═══ -->
        <Border x:Name="WizardBar" Grid.Row="2" Background="{DynamicResource SubtleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chế độ kiểm tra tập trung — mỗi lần 1 bài test" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="WizardBackButton" Content="← Quay lại bài trước" Click="OnWizardBackClick" Padding="12,4" Margin="16,0,0,0"/>
                <Button x:Name="WizardNextButton" Content="Bài tiếp theo →" Click="OnWizardNextClick" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Dừng tất cả test nặng" Click="OnWizardStopClick" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Thoát wizard" Click="OnWizardExitClick" Padding="12,4" Margin="8,0,0,0"
                        ToolTip="Thoát chế độ tập trung, mở lại menu bên trái. Trạng thái test đã xong không mất."/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左导航 + 内容 ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：导航项由 MainWindow.xaml.cs 按 plugins/ 目录实有插件动态生成。
                 完成态圆点约定：ListBoxItem 内容 = Grid(圆点 Ellipse + 对勾 TextBlock 默认 Collapsed) + 名称，
                 圆点/对勾登记进 _navDots（终点页插件用 Collapsed 占位圆点保持文字对齐）。
                 模块通过约定：页面实现 IModulePage 并触发 PassChanged(true) → 圆点变绿并自动跳到下一个
                 未完成模块；没有下一个时在导航底部显示「全部验机项目已完成」（AllDoneHint）。
                 插件增删见「插件管理」按钮（zip 导入即载；删除/覆盖走待处理操作 + 自动重启）。 -->
            <Border Grid.Column="0" Background="{DynamicResource SubtleBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Hạng mục kiểm tra máy"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" Margin="12,10,12,4"/>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="AllDoneHint" Text="🎉 Đã kiểm tra xong tất cả hạng mục"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="12,4,12,10" Visibility="Collapsed"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="An Tâm PC Test v1.1.0"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="12,4,12,10"/>
                    <Button DockPanel.Dock="Bottom" x:Name="VisitShopButton" Content="Tham quan shop"
                            Margin="12,4,12,4" Padding="8,6" Click="VisitShopButton_Click"
                            ToolTip="Mở website vitinhantam.com trong trình duyệt mặc định"/>
                    <!-- Khối thông tin shop trong phần mềm chính (chuyển từ Splash sang đây
                         để luôn nhìn thấy, không chỉ hiện 1,5 giây lúc khởi động).
                         Sidebar rộng cố định 200 nên chữ tự xuống dòng, khung hẹp cũng không vỡ.
                         Thứ tự khai báo Bottom ngược với thứ tự nhìn thấy: khối này khai sau nút
                         nên khi hiển thị nó nằm TRÊN nút, dưới NavList. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,4">
                        <TextBlock Text="Chi nhánh 1: 52 Nguyễn Cửu Vân, P. Long An, T. Tây Ninh"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock Text="Chi nhánh 2: 218/3 đường số 11, phường Thủ Đức, Tp. HCM"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock Text="vitinhantam.com"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Bảo hành 6 tháng nguyên máy"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="NavList" SelectionChanged="OnNavSelect" Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <!-- 内容区：页面实例常驻，切换不丢核对状态 -->
            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
