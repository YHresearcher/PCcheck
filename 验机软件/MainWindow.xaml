<Window x:Class="YanJi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="An Tâm PC check" Width="1536" Height="1024"
        MinWidth="940" MinHeight="680"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="/Fonts/#Be Vietnam Pro, Segoe UI, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Dải cam thương hiệu An Tâm trên cùng ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

        <!-- ═══ Top bar: logo + tên app + bên phải nút Dừng tất cả test nặng + công tắc theme ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource SubtleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,5">
            <!-- Top bar chia 2 cột (trái co giãn + phải tự rộng) để khi khung hẹp
                 thì chữ bên trái tự xuống dòng thay vì chèn lên nút bên phải như trước
                 (trước đây 2 StackPanel cùng nằm 1 ô Grid, không có cột, nên hẹp là chồng nhau).
                 Cột chữ cũng là Grid (logo Auto + chữ *) chứ không phải StackPanel ngang,
                 vì StackPanel ngang đo chữ với chiều rộng vô hạn nên TextWrapping không có tác dụng. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="pack://application:,,,/Assets/logo-antam.png"
                           Width="29" Height="29" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="An Tâm PC check" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Đồng hành cùng bạn chọn máy an tâm" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Dừng tất cả test nặng" Click="OnStopAllHeavyTestsClick" Padding="12,4" Margin="0,0,12,0"
                            ToolTip="Dừng thật Prime95 / FurMark / đo tốc độ ổ (kill có kiểm chứng, không chỉ dừng giao diện). Nếu còn tiến trình sống sẽ báo rõ tên để kiểm tra Task Manager."/>
                    <TextBlock Text="☀" FontSize="14" Margin="0,0,4,0"/>
                    <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeSwitch}"
                                  ToolTip="Đổi giao diện tối / sáng"
                                  Checked="OnThemeSwitch" Unchecked="OnThemeSwitch"/>
                    <TextBlock Text="🌙" FontSize="14" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Thanh wizard: chỉ hiện khi vào chế độ kiểm tra tập trung (Dashboard
             bấm Bắt đầu / Tiếp tục). Menu bên trái bị khóa lúc này để mỗi lần chỉ
             có 1 bài test chính, tránh thao tác nhầm; nút Thoát wizard luôn hiện
             để không bị kẹt trong wizard. ═══ -->
        <Border x:Name="WizardBar" Grid.Row="2" Background="{DynamicResource SubtleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chế độ kiểm tra tập trung — mỗi lần 1 bài test" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="WizardBackButton" Content="← Quay lại bài trước" Click="OnWizardBackClick" Padding="12,4" Margin="16,0,0,0"/>
                <Button x:Name="WizardNextButton" Content="Bài tiếp theo →" Click="OnWizardNextClick" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Dừng tất cả test nặng" Click="OnWizardStopClick" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Thoát wizard" Click="OnWizardExitClick" Padding="12,4" Margin="8,0,0,0"
                        ToolTip="Thoát chế độ tập trung, mở lại menu bên trái. Trạng thái test đã xong không mất."/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左导航 + 内容 ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="274"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：导航项由 MainWindow.xaml.cs 按 plugins/ 目录实有插件动态生成。
                 完成态圆点约定：ListBoxItem 内容 = Grid(圆点 Ellipse + 对勾 TextBlock 默认 Collapsed) + 名称，
                 圆点/对勾登记进 _navDots（终点页插件用 Collapsed 占位圆点保持文字对齐）。
                 模块通过约定：页面实现 IModulePage 并触发 PassChanged(true) → 圆点变绿并自动跳到下一个
                 未完成模块；没有下一个时在导航底部显示「全部验机项目已完成」（AllDoneHint）。
                 插件增删见「插件管理」按钮（zip 导入即载；删除/覆盖走待处理操作 + 自动重启）。 -->
            <Border Grid.Column="0" Background="{DynamicResource SubtleBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="14,20,14,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                            <Image Source="pack://application:,,,/Assets/logo-antam.png"
                                   Width="58" Height="58" Margin="0,0,10,0" Stretch="Uniform"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="An Tâm" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="PC check" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="⌂    Tổng quan" Click="SidebarOverview_Click"
                                HorizontalContentAlignment="Left" FontSize="15" FontWeight="SemiBold"
                                Padding="14,12" Margin="0,0,0,5"
                                Background="{DynamicResource NavSelectedBrush}"/>
                        <Button Content="▣    Kiểm tra chi tiết" Click="SidebarInspection_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Button Content="▥    Phần cứng &amp; Sức khỏe" Click="SidebarHardware_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Button Content="▤    Báo cáo" Click="SidebarReport_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Button Content="⚒    Công cụ tiện ích" Click="SidebarTools_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Separator Margin="0,12,0,12"/>
                        <Button Content="?    Hướng dẫn" Click="SidebarHelp_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Button Content="ⓘ    Giới thiệu" Click="SidebarAbout_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,17">
                        <!-- Brand mascot placeholder: no test outcomes implied. -->
                        <Border Background="{DynamicResource NavSelectedBrush}" CornerRadius="22"
                                Padding="16" Margin="18,0,18,14">
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/antam-mascot.png"
                                       Width="158" Height="112" Stretch="Uniform" Margin="0,0,0,3"/>
                                <TextBlock Text="An Tâm luôn bên bạn 🧡" FontSize="11"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="AllDoneHint" Text="🎉 Đã kiểm tra xong tất cả hạng mục!"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock Text="An Tâm PC check • Windows" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <!-- Giữ NavList động để wizard, plugin import và chấm trạng thái hoạt động nguyên vẹn. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Expander x:Name="TestsExpander" Header="Danh sách bài test"
                                  IsExpanded="False" Margin="10,0,10,8">
                            <ListBox x:Name="NavList" SelectionChanged="OnNavSelect"
                                     BorderThickness="0" Background="Transparent"/>
                        </Expander>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 内容区：页面实例常驻，切换不丢核对状态 -->
            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
