<Window x:Class="YanJi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="An Tâm Check" Width="1536" Height="1024"
        MinWidth="940" MinHeight="680"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="/Fonts/#Be Vietnam Pro, Segoe UI, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Dải cam thương hiệu An Tâm trên cùng ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

        <!-- Compact utility strip: thương hiệu hiển thị duy nhất trong sidebar. -->
        <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="☀" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeSwitch}"
                              ToolTip="{DynamicResource Shell.ThemeTip}"
                              Checked="OnThemeSwitch" Unchecked="OnThemeSwitch"/>
                <TextBlock Text="🌙" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Thanh wizard: chỉ hiện khi vào chế độ kiểm tra tập trung (Dashboard
             bấm Bắt đầu / Tiếp tục). Menu bên trái bị khóa lúc này để mỗi lần chỉ
             có 1 bài test chính, tránh thao tác nhầm; nút Dừng tất cả kiểm tra luôn hiện
             để không bị kẹt trong wizard. ═══ -->
        <Border x:Name="WizardBar" Grid.Row="2" Background="{DynamicResource SubtleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,6" Visibility="Collapsed">
            <!-- Nút wizard dùng style Button mặc định (nổi 3D kiểu Mac), không còn
                 style riêng — style WizardBarButton cũ đã bỏ vì trùng với mặc định. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Wizard.Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="WizardBackButton" Content="{DynamicResource Wizard.Back}" Click="OnWizardBackClick" Margin="16,0,0,0"/>
                <Button x:Name="WizardNextButton" Content="{DynamicResource Wizard.Next}" Click="OnWizardNextClick" Margin="8,0,0,0"/>
                                <Button Content="{DynamicResource Wizard.Exit}" Click="OnWizardExitClick" Margin="8,0,0,0"
                        ToolTip="{DynamicResource Wizard.ExitTip}"/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左导航 + 内容 ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：导航项由 MainWindow.xaml.cs 按 plugins/ 目录实有插件动态生成。
                 完成态圆点约定：ListBoxItem 内容 = Grid(圆点 Ellipse + 对勾 TextBlock 默认 Collapsed) + 名称，
                 圆点/对勾登记进 _navDots（终点页插件用 Collapsed 占位圆点保持文字对齐）。
                 模块通过约定：页面实现 IModulePage 并触发 PassChanged(true) → 圆点变绿并自动跳到下一个
                 未完成模块；没有下一个时在导航底部显示「全部验机项目已完成」（AllDoneHint）。
                 插件增删见「插件管理」按钮（zip 导入即载；删除/覆盖走待处理操作 + 自动重启）。 -->
            <Border Grid.Column="0" Background="{DynamicResource SubtleBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- NavList giữ lại nhưng ẩn: wizard, tự nhảy bài, chấm trạng thái
                         và import plugin vẫn dùng nó làm trạng thái chọn; chỉ bỏ phần
                         hiển thị "Danh sách bài test" khỏi sidebar theo yêu cầu. -->
                    <ListBox x:Name="NavList" SelectionChanged="OnNavSelect"
                             BorderThickness="0" Background="Transparent" Visibility="Collapsed"/>
                    <StackPanel DockPanel.Dock="Top" Margin="14,20,14,14">
                        <!-- Tên app mới, một dòng ngang canh giữa: "An Tâm" + logo
                             Windows xéo (perspective, 4 Polygon cam vẽ tay theo
                             hình logo chuẩn) + "Check" — chữ và logo đều màu cam,
                             font Be Vietnam Pro như website. Logo 28px, to hơn
                             bản 4 ô vuông 20px trước. Mascot dời xuống cuối
                             sidebar (xem SidebarMascot). -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="An Tâm" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <Viewbox Width="28" Height="28" Margin="8,0" VerticalAlignment="Center">
                                <Canvas Width="100" Height="100">
                                    <Polygon Points="4,26 48.5,15.4 48.5,48.5 4,51.5" Fill="{DynamicResource AccentBrush}"/>
                                    <Polygon Points="51.5,14.6 96,4 96,48.5 51.5,48.5" Fill="{DynamicResource AccentBrush}"/>
                                    <Polygon Points="4,51.5 48.5,51.5 48.5,84.6 4,74" Fill="{DynamicResource AccentBrush}"/>
                                    <Polygon Points="51.5,51.5 96,51.5 96,96 51.5,85.4" Fill="{DynamicResource AccentBrush}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Check" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="NavOverview" Click="SidebarOverview_Click"
                                Style="{StaticResource SidebarNavButton}"
                                FontSize="15" FontWeight="SemiBold"
                                Background="{DynamicResource NavSelectedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/14_home_orange.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.Overview}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavInspection" Click="SidebarInspection_Click"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/15_search_gray.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.Inspection}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavReport" Click="SidebarReport_Click"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/16_bar_chart_gray.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.Report}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Nút Giới thiệu: nút nổi 3D bo 18 kiểu Mac (khác 3 nút phẳng
                             trên), mở popup thông tin shop — không dùng UI mặc định Windows. -->
                        <Button x:Name="NavAbout" Click="SidebarAbout_Click"
                                Style="{StaticResource RaisedButton18}"
                                FontSize="14" Padding="14,11" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/17_info_gray.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Nav.About}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,17">
                                                <!-- Toggle đổi ngôn ngữ kiểu 3D chìm (neumorphic, theo mẫu
                             SwiftUI user gửi): track lõm + nút tròn trượt mang cờ
                             ngôn ngữ hiện tại; bấm để đổi. Nằm cuối sidebar, trên
                             mascot, canh giữa. Nhỏ gọn 98x30 (1/5 diện tích bản
                             220x68 trước), viền sáng + bóng đổ đậm để đọc rõ là
                             nút 3D chứ không phải pill phẳng. -->
                        <Button x:Name="LangButton" Click="OnLangButtonClick"
                                ToolTip="{DynamicResource Shell.LangTip}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Cursor="Hand" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Width="98" Height="30">
                                <!-- Vỏ capsule nổi: bóng tối dưới-phải -->
                                <Border CornerRadius="15" Background="#EDEDED">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.28" BlurRadius="5" ShadowDepth="4" Direction="45"/>
                                    </Border.Effect>
                                </Border>
                                <!-- Viền sáng trắng + bóng sáng trên-trái (nổi kiểu neumorphic) -->
                                <Border CornerRadius="15" Background="Transparent" BorderBrush="White" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="White" Opacity="0.9" BlurRadius="3" ShadowDepth="2" Direction="225"/>
                                    </Border.Effect>
                                </Border>
                                <!-- Track lõm: nền xám đậm hơn + viền tối trên-trái, sáng dưới-phải -->
                                <Border CornerRadius="13" Background="#CFCFCF" Margin="2" BorderBrush="#B5B5B5" BorderThickness="1,1,0,0"/>
                                <Border CornerRadius="13" Margin="2" BorderBrush="White" BorderThickness="0,0,1,1" Opacity="0.6"/>
                                <!-- Nhãn 2 nửa: chỉ hiện nhãn phía không có nút tròn
                                     (nút che phía ngôn ngữ hiện tại, như mask trong code mẫu) -->
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LangLabelVi" Grid.Column="0" Text="VI" FontSize="10" FontWeight="Medium"
                                               Foreground="Gray" Opacity="0.8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LangLabelEn" Grid.Column="1" Text="EN" FontSize="10" FontWeight="Medium"
                                               Foreground="Gray" Opacity="0.8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Nút tròn trượt -->
                                <Canvas>
                                    <Grid x:Name="LangKnob" Width="24" Height="24" Canvas.Left="4" Canvas.Top="3">
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="White" Offset="0"/>
                                                    <GradientStop Color="#D8D8D8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="3" ShadowDepth="2" Direction="45"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <!-- Vệt sáng trên nút tròn (cắt theo hình tròn) -->
                                        <Grid Width="24" Height="24">
                                            <Grid.Clip>
                                                <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                                            </Grid.Clip>
                                            <Ellipse Width="24" Height="12" VerticalAlignment="Top" Opacity="0.45">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="White" Offset="0"/>
                                                        <GradientStop Color="White" Offset="1" Opacity="0"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.Clip>
                                                <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/>
                                            </Grid.Clip>
                                            <Viewbox x:Name="LangKnobFlagUk" Stretch="UniformToFill">
                                                <Canvas Width="60" Height="40">
                                                    <Canvas.Clip>
                                                        <RectangleGeometry Rect="0,0,60,40"/>
                                                    </Canvas.Clip>
                                                    <Rectangle Width="60" Height="40" Fill="#012169"/>
                                                    <Rectangle Canvas.Left="-8" Canvas.Top="16" Width="76" Height="8" Fill="White" RenderTransformOrigin="0.5,0.5">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="33.69"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <Rectangle Canvas.Left="-8" Canvas.Top="16" Width="76" Height="8" Fill="White" RenderTransformOrigin="0.5,0.5">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="-33.69"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <Rectangle Canvas.Left="-8" Canvas.Top="18.5" Width="76" Height="3" Fill="#C8102E" RenderTransformOrigin="0.5,0.5">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="33.69"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <Rectangle Canvas.Left="-8" Canvas.Top="18.5" Width="76" Height="3" Fill="#C8102E" RenderTransformOrigin="0.5,0.5">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="-33.69"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <Rectangle Canvas.Left="23.33" Canvas.Top="0" Width="13.33" Height="40" Fill="White"/>
                                                    <Rectangle Canvas.Left="0" Canvas.Top="13.33" Width="60" Height="13.33" Fill="White"/>
                                                    <Rectangle Canvas.Left="26" Canvas.Top="0" Width="8" Height="40" Fill="#C8102E"/>
                                                    <Rectangle Canvas.Left="0" Canvas.Top="16" Width="60" Height="8" Fill="#C8102E"/>
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox x:Name="LangKnobFlagVn" Stretch="UniformToFill" Visibility="Collapsed">
                                                <Canvas Width="60" Height="40">
                                                    <Rectangle Width="60" Height="40" Fill="#DA251D"/>
                                                    <Polygon Points="30,6 33.23,15.55 43.31,15.67 35.23,21.7 38.23,31.33 30,25.5 21.77,31.33 24.77,21.7 16.69,15.67 26.77,15.55" Fill="#FFFF00"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Grid>
                                </Canvas>
                            </Grid>
                        </Button>
                        <!-- Mascot ở cuối sidebar, to (~200px), lấp khoảng trống dưới
                             nút Giới thiệu; màn hình thấp thì ẩn (AdjustSidebarForHeight). -->
                        <Image x:Name="SidebarMascot" Source="pack://application:,,,/Assets/mascot-sidebar-2026.png"
                               Width="400" Height="400" Stretch="Uniform" Margin="0,0,0,10"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="AllDoneHint" Text="{DynamicResource Shell.AllDone}"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock Text="{DynamicResource Shell.Footer}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容区：页面实例常驻，切换不丢核对状态 -->
            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
