<Window x:Class="YanJi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="An Tâm PC check" Width="1536" Height="1024"
        MinWidth="940" MinHeight="680"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="/Fonts/#Be Vietnam Pro, Segoe UI, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Dải cam thương hiệu An Tâm trên cùng ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

        <!-- Compact utility strip: thương hiệu hiển thị duy nhất trong sidebar. -->
        <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="Dừng test nặng" Click="OnStopAllHeavyTestsClick" Padding="10,4"
                        Margin="0,0,12,0"
                        ToolTip="Dừng Prime95 / FurMark / đo tốc độ ổ, kiểm tra tiến trình còn sống."/>
                <TextBlock Text="☀" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeSwitch}"
                              ToolTip="Đổi giao diện tối / sáng"
                              Checked="OnThemeSwitch" Unchecked="OnThemeSwitch"/>
                <TextBlock Text="🌙" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Thanh wizard: chỉ hiện khi vào chế độ kiểm tra tập trung (Dashboard
             bấm Bắt đầu / Tiếp tục). Menu bên trái bị khóa lúc này để mỗi lần chỉ
             có 1 bài test chính, tránh thao tác nhầm; nút Thoát wizard luôn hiện
             để không bị kẹt trong wizard. ═══ -->
        <Border x:Name="WizardBar" Grid.Row="2" Background="{DynamicResource SubtleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chế độ kiểm tra tập trung — mỗi lần 1 bài test" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="WizardBackButton" Content="← Quay lại bài trước" Click="OnWizardBackClick" Padding="12,4" Margin="16,0,0,0"/>
                <Button x:Name="WizardNextButton" Content="Bài tiếp theo →" Click="OnWizardNextClick" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Dừng tất cả test nặng" Click="OnWizardStopClick" Padding="12,4" Margin="8,0,0,0"/>
                <Button Content="Thoát wizard" Click="OnWizardExitClick" Padding="12,4" Margin="8,0,0,0"
                        ToolTip="Thoát chế độ tập trung, mở lại menu bên trái. Trạng thái test đã xong không mất."/>
            </StackPanel>
        </Border>

        <!-- ═══ 主区：左导航 + 内容 ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="274"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：导航项由 MainWindow.xaml.cs 按 plugins/ 目录实有插件动态生成。
                 完成态圆点约定：ListBoxItem 内容 = Grid(圆点 Ellipse + 对勾 TextBlock 默认 Collapsed) + 名称，
                 圆点/对勾登记进 _navDots（终点页插件用 Collapsed 占位圆点保持文字对齐）。
                 模块通过约定：页面实现 IModulePage 并触发 PassChanged(true) → 圆点变绿并自动跳到下一个
                 未完成模块；没有下一个时在导航底部显示「全部验机项目已完成」（AllDoneHint）。
                 插件增删见「插件管理」按钮（zip 导入即载；删除/覆盖走待处理操作 + 自动重启）。 -->
            <Border Grid.Column="0" Background="{DynamicResource SubtleBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- NavList giữ lại nhưng ẩn: wizard, tự nhảy bài, chấm trạng thái
                         và import plugin vẫn dùng nó làm trạng thái chọn; chỉ bỏ phần
                         hiển thị "Danh sách bài test" khỏi sidebar theo yêu cầu. -->
                    <ListBox x:Name="NavList" SelectionChanged="OnNavSelect"
                             BorderThickness="0" Background="Transparent" Visibility="Collapsed"/>
                    <StackPanel DockPanel.Dock="Top" Margin="14,20,14,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Image Source="pack://application:,,,/Assets/mascot-checklist-2026.png"
                                   Width="124" Height="100" Margin="0,0,8,0"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="An Tâm" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="PC check" FontSize="19" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="NavOverview" Content="⌂    Tổng quan" Click="SidebarOverview_Click"
                                HorizontalContentAlignment="Left" FontSize="15" FontWeight="SemiBold"
                                Padding="14,12" Margin="0,0,0,5"
                                Background="{DynamicResource NavSelectedBrush}"/>
                        <Button x:Name="NavInspection" Content="▣    Kiểm tra chi tiết" Click="SidebarInspection_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Button x:Name="NavHardware" Content="▥    Phần cứng &amp; Sức khỏe" Click="SidebarHardware_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Button x:Name="NavReport" Content="▤    Báo cáo" Click="SidebarReport_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                        <Button x:Name="NavTools" Content="⚒    Công cụ tiện ích" Click="SidebarTools_Click"
                                HorizontalContentAlignment="Left" FontSize="14"
                                Padding="14,11" Margin="0,0,0,5"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,17">
                        <!-- Mascot checklist chỉ xuất hiện ở header, theo bản thiết kế đã duyệt. -->
                        <Border x:Name="MascotBrand" Height="0" Visibility="Collapsed"/>
                        <TextBlock x:Name="AllDoneHint" Text="🎉 Đã kiểm tra xong tất cả hạng mục!"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock Text="An Tâm PC check • Windows" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <!-- Thẻ shop dời từ Dashboard sang sidebar (nội dung giữ nguyên,
                         chỉ thu gọn cho vừa chiều rộng sidebar). -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{DynamicResource SurfaceBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                            HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/logo-antam.png"
                                           Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Vi tính An Tâm" FontWeight="Bold"
                                               FontSize="17" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="{DynamicResource NavSelectedBrush}"
                                        CornerRadius="10" Padding="8,6" Margin="0,0,0,10">
                                    <TextBlock Text="Bán bằng tâm để bạn yên tâm"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" FontSize="11"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="⌖  Chi nhánh 1: 52 Nguyễn Cửu Vân, P. Long An, T. Tây Ninh"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="⌖  Chi nhánh 2: 218/3 đường số 11, phường Thủ Đức, TP. Hồ Chí Minh"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="◎  vitinhantam.com"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,12"/>
                                <Button Content="↗  Ghé qua shop" Click="VisitShopButton_Click"
                                        HorizontalAlignment="Stretch" Padding="10,8"
                                        Foreground="{DynamicResource AccentBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        Background="{DynamicResource SurfaceBgBrush}"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 内容区：页面实例常驻，切换不丢核对状态 -->
            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
