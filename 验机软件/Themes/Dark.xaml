<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主题令牌（Vi Tính An Tâm 品牌）：与 Light.xaml 键集完全一致。
         深色主题 là giao diện thương hiệu chính：nền gần đen như logo trình bày trên nền đen，
         Accent dùng đúng màu logo #ED740C，hover sáng hơn một nấc。 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#111111"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#262626"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B0A8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#555555"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#ED740C"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F5861F"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2E2A26"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#3D2A1A"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B5E"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#B8B0A8"/>
    <SolidColorBrush x:Key="ChartNoDataBrush" Color="#444444"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#55504A"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6E675F"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#262626"/>
</ResourceDictionary>
