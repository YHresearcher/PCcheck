<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Chủ đề tối: Mac không có dark mode (luôn nền sáng cố định), nên bản tối
         của PCcheck chỉ "ấm hóa" theo họ màu Mac — nền nâu gần đen thay vì xám
         trung tính, cam giữ đúng màu logo #ED740C. Khóa phải khớp hoàn toàn
         với Light.xaml. -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#171310"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#221B15"/>
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#2A211A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F1EA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8AC9C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3226"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#57493A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#ED740C"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F5861F"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2E2620"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#3D2A1A"/>
    <SolidColorBrush x:Key="NavIdleBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B5E"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#33291F"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#B8AC9C"/>
    <SolidColorBrush x:Key="ChartNoDataBrush" Color="#453A2E"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#57493A"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6E675F"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#2A211A"/>
    <!-- Nút nổi 3D kiểu Mac, bản tối: gradient nâu ấm (thường) và cam logo (chính). -->
    <LinearGradientBrush x:Key="ButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E2721" Offset="0"/>
        <GradientStop Color="#241C16" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPrimaryBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ED740C" Offset="0"/>
        <GradientStop Color="#D95E00" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
