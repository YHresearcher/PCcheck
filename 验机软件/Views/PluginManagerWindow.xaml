<Window x:Class="YanJi.Views.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Module" Width="600" Height="440" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Module đã cài (thư mục plugins/; module mới nhập là chạy ngay, xóa / ghi đè cần tự khởi động lại để hoàn tất)"
                   FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PluginList"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Nhập gói module (.zip)…" Click="OnImportClick" Padding="12,4"
                    ToolTip="Chọn gói module dạng zip để nhập (gồm plugin.json + file dll của module), khởi động lại sẽ có hiệu lực"/>
        </StackPanel>
    </Grid>
</Window>
