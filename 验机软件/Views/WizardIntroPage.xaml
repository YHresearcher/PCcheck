<UserControl x:Class="YanJi.Views.WizardIntroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Màn hình Bắt đầu trước wizard: chọn Fast/Deep check rồi xem lưới ô
         kiểm tra kiểu Mac (mỗi ô nền pastel riêng + icon + trạng thái).
         Bấm Bắt đầu mới vào bài chưa xong đầu tiên — màn hình này chưa khóa
         điều hướng. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBgBrush}">
        <StackPanel Margin="40,32,40,24" MaxWidth="640" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource Wiz.IntroTitle}" FontSize="24" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Wiz.IntroText}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>
            <TextBlock Text="{DynamicResource Wiz.ModeTitle}" FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="FastCardButton" Grid.Column="0" Margin="0,0,6,0" Click="FastCard_Click"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border x:Name="FastCardBorder" CornerRadius="12" Padding="12" Background="#E6F8E7"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/Assets/08_lightning_orange.png"
                                   Width="28" Height="28" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="FastCheckMark" Grid.Row="0" Grid.Column="1" Text="✓" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{DynamicResource Wiz.FastTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource Wiz.FastDesc}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Button>
                <Button x:Name="DeepCardButton" Grid.Column="1" Margin="6,0,0,0" Click="DeepCard_Click"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border x:Name="DeepCardBorder" CornerRadius="12" Padding="12" Background="#FFE9E3"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/Assets/03_cpu_chip_gray.png"
                                   Width="28" Height="28" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="DeepCheckMark" Grid.Row="0" Grid.Column="1" Text="✓" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Visibility="Collapsed"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{DynamicResource Wiz.DeepTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource Wiz.DeepDesc}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Button>
            </Grid>
            <TextBlock Text="{DynamicResource Wiz.GridTitle}" FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <!-- Lưới ô kiểm tra kiểu Mac: mỗi ô nền pastel riêng, icon 31 trong
                 hộp trắng mờ + tên bài + icon trạng thái 24 (chỉ xem, không bấm). -->
            <ItemsControl x:Name="ModuleList" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Width="185" Margin="0,0,8,8" Padding="10"
                                Background="{Binding RowBrush}" ToolTip="{Binding State}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="31"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#91FFFFFF"
                                        Width="31" Height="31" CornerRadius="8">
                                    <Grid>
                                        <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding Icon}" FontSize="16"
                                                   Foreground="{Binding IconBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                <Grid Grid.Column="2">
                                    <Image Source="{Binding StatusIcon}" Width="20" Height="20" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusIcon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="{Binding Mark}" FontSize="15" FontWeight="Bold"
                                               Foreground="{Binding MarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusIcon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource RaisedButton18}"
                    Background="{DynamicResource ButtonPrimaryBgBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" Foreground="White"
                    Content="{DynamicResource Wiz.IntroStart}"
                    Padding="24,12" FontSize="16" FontWeight="SemiBold"
                    HorizontalAlignment="Left" Click="StartButton_Click"/>
            <TextBlock Text="{DynamicResource Wiz.IntroNote}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
