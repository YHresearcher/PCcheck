<UserControl x:Class="YanJi.Views.WizardIntroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Màn hình Bắt đầu trước wizard: liệt kê bài test + trạng thái, nút
         Bắt đầu mới vào bài chưa xong đầu tiên (không nhảy thẳng như trước). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBgBrush}">
        <StackPanel Margin="40,32,40,24" MaxWidth="640" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource Wiz.IntroTitle}" FontSize="24" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Wiz.IntroText}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>
            <ItemsControl x:Name="ModuleList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Margin="0,2" Padding="10,8"
                                Background="{DynamicResource SurfaceBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Mark}" FontSize="15" FontWeight="Bold"
                                           Foreground="{Binding MarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12"
                                           Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource RaisedButton18}"
                    Background="{DynamicResource ButtonPrimaryBgBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" Foreground="White"
                    Content="{DynamicResource Wiz.IntroStart}"
                    Padding="24,12" FontSize="16" FontWeight="SemiBold"
                    HorizontalAlignment="Left" Click="StartButton_Click"/>
            <TextBlock Text="{DynamicResource Wiz.IntroNote}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
