<UserControl x:Class="YanJi.Plugin.DiskMark.DiskMarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YanJi.Plugin.DiskMark">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="860">

            <!-- 状态行：通过后变绿（通用约定） -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="{DynamicResource Disk.StatusLabel}" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Disk.StatusNotMeasured}" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 控制卡：目标盘 + 开始/取消 + 进度 -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,8,0,0" Padding="14,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Disk.DriveLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="DriveBox" Width="90" Margin="8,0,0,0"
                                  ToolTip="{DynamicResource Disk.DriveTooltip}"/>
                        <Button x:Name="RunButton" Content="{DynamicResource Disk.Run}" FontSize="14" FontWeight="SemiBold"
                                Padding="16,7" Margin="12,3,2,3" Click="RunButton_Click"
                                ToolTip="{DynamicResource Disk.RunTooltip}"/>
                        <Button x:Name="CancelButton" Content="{DynamicResource Disk.Cancel}" IsEnabled="False"
                                Padding="16,7" Margin="8,3,2,3" Click="CancelButton_Click"/>
                        <ProgressBar x:Name="TestProgress" Width="220" Height="8" Margin="14,0,0,0"
                                     VerticalAlignment="Center" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="PhaseText" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Disk.HowText}"
                               Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{DynamicResource Disk.WarningText}"
                               Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 成绩卡：四项大数字 + 打开成绩目录 -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Disk.SeqRead}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ScoreSeqRead" Text="—" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Disk.SeqWrite}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ScoreSeqWrite" Text="—" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Disk.Rnd4KRead}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Score4KRead" Text="—" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Disk.Rnd4KWrite}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Score4KWrite" Text="—" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <Button x:Name="OpenResultDirButton" Content="{DynamicResource Disk.OpenResultDir}" Padding="12,3"
                                    FontSize="11" HorizontalAlignment="Right" Click="OpenResultDir_Click"
                                    ToolTip="{DynamicResource Disk.OpenResultDirTooltip}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DetailText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 结论卡：硬盘结论（仅评价这块盘好不好，不是整机购买结论；不 chặn nút cho qua，不改结论总） -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Disk.ConclusionTitle}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="DriveInfoText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DriveHealthText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DriveSpeedText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DriveConclusionText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- 运行日志：Consolas（LogBox 惯例），自动滚底，上限 500 条；圆角 = 外套圆角 Border -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Disk.LogTitle}" FontWeight="SemiBold" FontSize="13"/>
                    <Border Margin="0,6,0,0" CornerRadius="6"
                            Background="{DynamicResource SurfaceBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="LogBox" Height="110" Padding="6,4"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 通过区 -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                <Button x:Name="PassButton" Content="{DynamicResource Disk.Pass}"
                        FontSize="14" FontWeight="SemiBold" Padding="16,7" Click="PassButton_Click"
                        ToolTip="{DynamicResource Disk.PassTooltip}"/>
                <TextBlock x:Name="PassHintText" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
