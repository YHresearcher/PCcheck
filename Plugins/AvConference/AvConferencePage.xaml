<UserControl x:Class="YanJi.Plugin.AvConference.AvConferencePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- 状态行：通过后变绿 -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Trạng thái test:" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Chưa test" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- ═══ 摄像头 ═══ -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,8,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Camera" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Thiết bị:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="CameraBox" Width="360" SelectionChanged="CameraBox_Changed"/>
                    </StackPanel>
                    <Border Margin="0,8,0,0" Width="480" Height="270" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <TextBlock x:Name="CameraError" TextWrapping="Wrap" Margin="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Đang khởi động camera…"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Rời trang này là camera tự tắt (đèn báo tắt)" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 麦克风 ═══ -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Mic" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Thiết bị:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="MicBox" Width="360" SelectionChanged="MicBox_Changed"/>
                    </StackPanel>
                    <ProgressBar x:Name="MicLevel" Margin="2,8" Minimum="0" Maximum="100"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RecordButton" Content="Ghi âm" Click="RecordButton_Click"
                                ToolTip="Ghi 1 đoạn từ mic (tối đa 15 giây, tự dừng)"/>
                        <Button x:Name="PlayRecButton" Content="Phát lại" IsEnabled="False" Click="PlayRecButton_Click"
                                ToolTip="Phát lại đoạn vừa ghi qua loa đã chọn bên dưới"/>
                        <TextBlock x:Name="MicStatus" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 扬声器 ═══ -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Loa" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Thiết bị:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="SpkBox" Width="360"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Button x:Name="PlayMusicButton" Content="Phát nhạc test" Click="PlayMusicButton_Click"
                                ToolTip="Phát nhạc test qua thiết bị đã chọn"/>
                        <TextBlock x:Name="MusicStatus" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="试音曲「不死のバイオレット」Copyright© 幻月遠征隊，使用已经著作权人同意。"/>
                </StackPanel>
            </Border>

            <!-- 通过按钮 -->
            <!-- Tick tay những gì phần mềm không tự kết luận: loa rè (nghe mới biết),
                 camera không lên hình (nhìn mới biết). Tick thì bấm cho qua vẫn ghi
                 nhận lỗi vào kết luận, không phải là "không lỗi". -->
            <StackPanel Margin="0,12,0,0">
                <CheckBox x:Name="SpeakerCheck" Content="Loa rè" Margin="0,0,0,4"
                          ToolTip="Tick khi nghe loa rè khi phát nhạc test — bấm cho qua vẫn ghi nhận lỗi vào kết luận"/>
                <CheckBox x:Name="WebcamCheck" Content="Camera không hoạt động / không lên hình" Margin="0,0,0,8"
                          ToolTip="Tick khi camera không lên hình dù đã chọn đúng thiết bị — bấm cho qua vẫn ghi nhận lỗi vào kết luận"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="PassButton" Content="Xác nhận không lỗi, cho qua" Click="PassButton_Click"
                        FontSize="14" FontWeight="SemiBold" Padding="16,7"
                        ToolTip="Khi camera lên hình, mic có mức âm và ghi/phát lại bình thường, loa kêu thì bấm nút này"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
