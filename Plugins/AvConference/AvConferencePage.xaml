<UserControl x:Class="YanJi.Plugin.AvConference.AvConferencePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- 状态行：通过后变绿 -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="{DynamicResource Av.StatusLabel}" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Av.NotTested}" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- ═══ 摄像头 ═══ -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,8,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Av.CameraTitle}" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Av.DeviceLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="CameraBox" Width="360" SelectionChanged="CameraBox_Changed"/>
                    </StackPanel>
                    <Border Margin="0,8,0,0" Width="480" Height="270" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <TextBlock x:Name="CameraError" TextWrapping="Wrap" Margin="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{DynamicResource Av.CameraStarting}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{DynamicResource Av.CameraAutoOff}" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 麦克风 ═══ -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Av.MicTitle}" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Av.DeviceLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="MicBox" Width="360" SelectionChanged="MicBox_Changed"/>
                    </StackPanel>
                    <ProgressBar x:Name="MicLevel" Margin="2,8" Minimum="0" Maximum="100"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RecordButton" Content="{DynamicResource Av.Record}" Click="RecordButton_Click"
                                ToolTip="{DynamicResource Av.RecordTip}"/>
                        <Button x:Name="PlayRecButton" Content="{DynamicResource Av.Playback}" IsEnabled="False" Click="PlayRecButton_Click"
                                ToolTip="{DynamicResource Av.PlaybackTip}"/>
                        <TextBlock x:Name="MicStatus" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 扬声器 ═══ -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Av.SpeakerTitle}" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Av.DeviceLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="SpkBox" Width="360"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Button x:Name="PlayMusicButton" Content="{DynamicResource Av.PlayMusic}" Click="PlayMusicButton_Click"
                                ToolTip="{DynamicResource Av.PlayMusicTip}"/>
                        <TextBlock x:Name="MusicStatus" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="试音曲「不死のバイオレット」Copyright© 幻月遠征隊，使用已经著作权人同意。"/>
                </StackPanel>
            </Border>

            <!-- 通过按钮 -->
            <!-- Tick tay những gì phần mềm không tự kết luận: loa rè (nghe mới biết),
                 camera không lên hình (nhìn mới biết). Tick thì bấm cho qua vẫn ghi
                 nhận lỗi vào kết luận, không phải là "không lỗi". -->
            <StackPanel Margin="0,12,0,0">
                <CheckBox x:Name="SpeakerCheck" Content="{DynamicResource Av.SpeakerDistorted}" Margin="0,0,0,4"
                          ToolTip="{DynamicResource Av.SpeakerDistortedTip}"/>
                <CheckBox x:Name="WebcamCheck" Content="{DynamicResource Av.WebcamFail}" Margin="0,0,0,8"
                          ToolTip="{DynamicResource Av.WebcamFailTip}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="PassButton" Content="{DynamicResource Av.PassButton}" Click="PassButton_Click"
                        FontSize="14" FontWeight="SemiBold" Padding="16,7"
                        ToolTip="{DynamicResource Av.PassTip}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
