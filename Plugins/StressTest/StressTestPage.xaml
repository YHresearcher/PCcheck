<UserControl x:Class="YanJi.Plugin.StressTest.StressTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YanJi.Plugin.StressTest">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="860">

            <!-- 状态行：通过后变绿（通用约定） -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Trạng thái kiểm tra:" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Chờ kiểm tra" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 控制区：模式 + 开始/停止 + 时长 -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,8,0,0" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Chế độ nướng máy" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModeBox" Width="130" Margin="8,0,0,0" SelectedIndex="2">
                                <ComboBoxItem Content="Nướng CPU" Tag="Cpu"/>
                                <ComboBoxItem Content="Nướng GPU" Tag="Gpu"/>
                                <ComboBoxItem Content="Nướng cả hai" Tag="Both"/>
                            </ComboBox>
                            <Button x:Name="StartButton" Content="Bắt đầu nướng máy" Margin="12,3,2,3"
                                    FontSize="14" FontWeight="SemiBold" Padding="16,7" Click="StartButton_Click"
                                    ToolTip="Khởi động prime95 và/hoặc FurMark theo chế độ đã chọn (mở cửa sổ riêng)"/>
                            <Button x:Name="StopButton" Content="Dừng nướng" Margin="8,3,2,3" IsEnabled="False"
                                    Padding="16,7" Click="StopButton_Click"
                                    ToolTip="Dừng toàn bộ tiến trình nướng máy"/>
                        </StackPanel>
                        <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="Chưa nướng máy"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <TextBlock x:Name="RunStateText" Text="Chưa nướng máy lần nào; nướng máy làm phần cứng chạy hết công suất và nóng lên, chú ý nhiệt độ và quạt"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DurationHintText" Text="Thời lượng nướng khuyến nghị: 3 phút (đổi ở Cài đặt). Mặc định không tự dừng — kỹ thuật viên tự quyết dừng khi nào."
                               Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <!-- Tick tay những gì phần mềm không tự phát hiện: CPU lỗi/crash
                         và lỗi hiển thị GPU (artifact) chỉ mắt người mới thấy khi nướng.
                         Tick 1 trong 2 ô này thì nút cho qua sẽ bị chặn (giống ổ bị chặn),
                         và Tổng kết ra câu lỗi nghiêm trọng tương ứng. -->
                    <CheckBox x:Name="CpuFailCheck" Content="CPU gặp lỗi / crash khi nướng (prime95 báo lỗi hoặc tự thoát)"
                              Margin="0,8,0,0" ToolTip="Chỉ tick khi tận mắt thấy prime95 báo lỗi hoặc tự thoát — phần mềm không tự đọc được lỗi prime95"/>
                    <CheckBox x:Name="GpuArtifactCheck" Content="Phát hiện lỗi hiển thị GPU (artifact: sọc, đốm, hình vỡ) khi nướng FurMark"
                              Margin="0,4,0,0" ToolTip="Chỉ tick khi tận mắt thấy lỗi hiển thị trong cửa sổ FurMark — phần mềm không tự phát hiện artifact"/>
                </StackPanel>
            </Border>

            <!-- 设置区：FurMark（GPU）+ prime95（CPU）两卡片并排 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Width="Auto"
                        Margin="0,0,6,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Cài đặt FurMark (Nướng GPU)" FontWeight="SemiBold" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Độ phân giải" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ResolutionBox" Width="150">
                                <ComboBoxItem Content="1280 × 720" Tag="1280x720"/>
                                <ComboBoxItem Content="1600 × 900" Tag="1600x900"/>
                                <ComboBoxItem Content="1920 × 1080" Tag="1920x1080"/>
                                <ComboBoxItem Content="2560 × 1440" Tag="2560x1440"/>
                                <ComboBoxItem Content="3840 × 2160 (4K)" Tag="3840x2160" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Chống răng cưa" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="MsaaBox" Width="150">
                                <ComboBoxItem Content="Tắt" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="2x MSAA" Tag="2"/>
                                <ComboBoxItem Content="4x MSAA" Tag="4"/>
                                <ComboBoxItem Content="8x MSAA" Tag="8"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="FullscreenCheck" Content="Nướng toàn màn hình (bấm Esc hoặc đóng cửa sổ để thoát)" Margin="0,6,0,0"/>
                        <CheckBox x:Name="FurShowUiCheck" Content="Hiện giao diện (không tick thì nướng chạy ngầm, không hiện cửa sổ)" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Width="Auto"
                        Margin="6,0,0,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Cài đặt prime95 (Nướng CPU)" FontWeight="SemiBold" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Số luồng" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ThreadsBox" Width="150"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Chế độ FFT" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="FftBox" Width="150" SelectedIndex="1">
                                <ComboBoxItem Content="Cân bằng Blend" Tag="Blend"/>
                                <ComboBoxItem Content="FFT nhỏ (nhiệt cao)" Tag="SmallHot"/>
                                <ComboBoxItem Content="FFT lớn (nặng RAM)" Tag="LargeMem"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="CoresHint" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <CheckBox x:Name="P95ShowUiCheck" Content="Hiện giao diện (không tick thì nướng chạy ngầm, không hiện cửa sổ)" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 数据监控：LHM 传感器 1 秒轮询，四路实时折线（页面可见时才轮询） -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Theo dõi số liệu (LibreHardwareMonitor quét mỗi 2 giây)" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="GPU" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <!-- 显卡选择：LHM 枚举的全部带温度/功耗传感器的显卡，默认独显（启发式口径见交接文档） -->
                            <ComboBox x:Name="GpuBox" Width="290" Margin="6,0,0,0"
                                      SelectionChanged="GpuBox_Changed" Visibility="Collapsed"
                                      ToolTip="Chọn card màn hình cần theo dõi nhiệt độ/công suất (đổi là đổi card theo dõi, xóa đồ thị cũ)"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- CPU 两路：叠层 = 占位文案 + 「安装 PawnIO 驱动」按钮（不可用时显示；
                             可用时收起，图表正常画线） -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                            <views:LineChartControl x:Name="CpuTempChart"
                                                    Title="Nhiệt độ CPU" Unit="℃" SampleIntervalSeconds="2"/>
                            <StackPanel x:Name="CpuTempOverlay" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Không đọc được cảm biến (cần driver PawnIO)"
                                           Foreground="{DynamicResource ChartNoDataBrush}"
                                           HorizontalAlignment="Center"/>
                                <Button Content="Cài driver PawnIO" Margin="0,6,0,0" Padding="14,4"
                                        Click="InstallPawnIo_Click"
                                        ToolTip="Chạy trình cài đặt chính thức có chữ ký (namazso, GPL-2.0) để cài lặng driver nhân PawnIO; driver này cài trên từng máy test, không đi theo USB; cài xong dùng được ngay, không cần khởi động lại"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                            <views:LineChartControl x:Name="CpuPowerChart"
                                                    Title="Công suất CPU" Unit="W" SampleIntervalSeconds="2"/>
                            <StackPanel x:Name="CpuPowerOverlay" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Không đọc được cảm biến (cần driver PawnIO)"
                                           Foreground="{DynamicResource ChartNoDataBrush}"
                                           HorizontalAlignment="Center"/>
                                <Button Content="Cài driver PawnIO" Margin="0,6,0,0" Padding="14,4"
                                        Click="InstallPawnIo_Click"
                                        ToolTip="Chạy trình cài đặt chính thức có chữ ký (namazso, GPL-2.0) để cài lặng driver nhân PawnIO; driver này cài trên từng máy test, không đi theo USB; cài xong dùng được ngay, không cần khởi động lại"/>
                            </StackPanel>
                        </Grid>
                        <views:LineChartControl x:Name="GpuTempChart" Grid.Row="1" Grid.Column="0"
                                                Title="Nhiệt độ GPU" Unit="℃" Margin="0,0,6,0" SampleIntervalSeconds="2"/>
                        <views:LineChartControl x:Name="GpuPowerChart" Grid.Row="1" Grid.Column="1"
                                                Title="Công suất GPU" Unit="W" Margin="6,0,0,0" SampleIntervalSeconds="2"/>
                    </Grid>
                    <!-- 传感器口径：每路一行「指标 ← 硬件 / 传感器」，不可用的行注明状态 -->
                    <TextBlock x:Name="SensorHintText" Margin="0,8,0,0" TextWrapping="Wrap"
                               FontSize="11" LineHeight="17"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 运行日志：Consolas（LogBox 惯例同键盘页），自动滚底，上限 500 条；
                 圆角 = 外套圆角 Border（TextBox 去边框去底色嵌入） -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Nhật ký chạy" FontWeight="SemiBold" FontSize="13"/>
                    <Border Margin="0,6,0,0" CornerRadius="6"
                            Background="{DynamicResource SurfaceBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="LogBox" Height="110" Padding="6,4"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 通过区 -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                <Button x:Name="PassButton" Content="Xác nhận tản nhiệt đạt, cho qua"
                        FontSize="14" FontWeight="SemiBold" Padding="16,7" Click="PassButton_Click"
                        ToolTip="Người test tự đánh giá nhiệt độ và độ ổn định trong lúc nướng thấy đạt thì bấm (sẽ dừng nướng máy)"/>
                <TextBlock x:Name="PassHintText" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
