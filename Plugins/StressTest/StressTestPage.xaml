<UserControl x:Class="YanJi.Plugin.StressTest.StressTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YanJi.Plugin.StressTest">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="860">

            <!-- 状态行：通过后变绿（通用约定） -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="{DynamicResource Stress.StatusLabel}" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Stress.Status.Waiting}" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 控制区：模式 + 开始/停止 + 时长 -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,8,0,0" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Stress.ModeLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModeBox" Width="130" Margin="8,0,0,0" SelectedIndex="2">
                                <ComboBoxItem Content="{DynamicResource Stress.Mode.Cpu}" Tag="Cpu"/>
                                <ComboBoxItem Content="{DynamicResource Stress.Mode.Gpu}" Tag="Gpu"/>
                                <ComboBoxItem Content="{DynamicResource Stress.Mode.Both}" Tag="Both"/>
                            </ComboBox>
                            <Button x:Name="StartButton" Content="{DynamicResource Stress.Start}" Margin="12,3,2,3"
                                    FontSize="14" FontWeight="SemiBold" Padding="16,7" Click="StartButton_Click"
                                    ToolTip="{DynamicResource Stress.StartTip}"/>
                            <Button x:Name="StopButton" Content="{DynamicResource Stress.Stop}" Margin="8,3,2,3" IsEnabled="False"
                                    Padding="16,7" Click="StopButton_Click"
                                    ToolTip="{DynamicResource Stress.StopTip}"/>
                        </StackPanel>
                        <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="{DynamicResource Stress.NotStressed}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <TextBlock x:Name="RunStateText" Text="{DynamicResource Stress.RunState.Never}"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{DynamicResource Stress.Purpose}"
                               Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{DynamicResource Stress.Recommendation}"
                               Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Stress.DurationLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="StressMinutesBox" Width="60" Margin="8,0,0,0" Padding="6,4"/>
                        <TextBlock Text="{DynamicResource Stress.Minutes}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <CheckBox x:Name="AutoStopCheck" Content="{DynamicResource Stress.AutoStop}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <Button x:Name="SaveStressSettingsButton" Content="{DynamicResource Stress.Save}" Padding="16,7" Margin="12,0,0,0" Click="SaveStressSettingsButton_Click"/>
                        <TextBlock x:Name="StressSettingsStatusText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <!-- Tick tay những gì phần mềm không tự phát hiện: CPU lỗi/crash
                         và lỗi hiển thị GPU (artifact) chỉ mắt người mới thấy khi nướng.
                         Tick 1 trong 2 ô này thì nút cho qua sẽ bị chặn (giống ổ bị chặn),
                         và Tổng kết ra câu lỗi nghiêm trọng tương ứng. -->
                    <CheckBox x:Name="CpuFailCheck" Content="{DynamicResource Stress.CpuFailCheck}"
                              Margin="0,8,0,0" ToolTip="{DynamicResource Stress.CpuFailTip}"/>
                    <CheckBox x:Name="GpuArtifactCheck" Content="{DynamicResource Stress.GpuArtifactCheck}"
                              Margin="0,4,0,0" ToolTip="{DynamicResource Stress.GpuArtifactTip}"/>
                </StackPanel>
            </Border>

            <!-- 设置区：FurMark（GPU）+ prime95（CPU）两卡片并排 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Width="Auto"
                        Margin="0,0,6,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stress.FurMarkTitle}" FontWeight="SemiBold" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource Stress.Resolution}" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ResolutionBox" Width="150">
                                <ComboBoxItem Content="1280 × 720" Tag="1280x720"/>
                                <ComboBoxItem Content="1600 × 900" Tag="1600x900"/>
                                <ComboBoxItem Content="1920 × 1080" Tag="1920x1080"/>
                                <ComboBoxItem Content="2560 × 1440" Tag="2560x1440"/>
                                <ComboBoxItem Content="3840 × 2160 (4K)" Tag="3840x2160" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource Stress.AntiAliasing}" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="MsaaBox" Width="150">
                                <ComboBoxItem Content="{DynamicResource Stress.MsaaOff}" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="2x MSAA" Tag="2"/>
                                <ComboBoxItem Content="4x MSAA" Tag="4"/>
                                <ComboBoxItem Content="8x MSAA" Tag="8"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="FullscreenCheck" Content="{DynamicResource Stress.Fullscreen}" Margin="0,6,0,0"/>
                        <CheckBox x:Name="FurShowUiCheck" Content="{DynamicResource Stress.ShowUi}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Width="Auto"
                        Margin="6,0,0,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stress.Prime95Title}" FontWeight="SemiBold" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource Stress.Threads}" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ThreadsBox" Width="150"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource Stress.FftMode}" Width="64" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="FftBox" Width="150" SelectedIndex="1">
                                <ComboBoxItem Content="{DynamicResource Stress.Fft.Blend}" Tag="Blend"/>
                                <ComboBoxItem Content="{DynamicResource Stress.Fft.SmallHot}" Tag="SmallHot"/>
                                <ComboBoxItem Content="{DynamicResource Stress.Fft.LargeMem}" Tag="LargeMem"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="CoresHint" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <CheckBox x:Name="P95ShowUiCheck" Content="{DynamicResource Stress.ShowUi}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 数据监控：LHM 传感器 1 秒轮询，四路实时折线（页面可见时才轮询） -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Stress.MonitorTitle}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="GPU" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <!-- 显卡选择：LHM 枚举的全部带温度/功耗传感器的显卡，默认独显（启发式口径见交接文档） -->
                            <ComboBox x:Name="GpuBox" Width="290" Margin="6,0,0,0"
                                      SelectionChanged="GpuBox_Changed" Visibility="Collapsed"
                                      ToolTip="{DynamicResource Stress.GpuSelectTip}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- CPU 两路：叠层 = 占位文案 + 「安装 PawnIO 驱动」按钮（不可用时显示；
                             可用时收起，图表正常画线） -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                            <views:LineChartControl x:Name="CpuTempChart"
                                                    Title="{DynamicResource Stress.Chart.CpuTemp}" Unit="℃" SampleIntervalSeconds="2"/>
                            <StackPanel x:Name="CpuTempOverlay" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Stress.NoSensorDriver}"
                                           Foreground="{DynamicResource ChartNoDataBrush}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="InstallDriverButtonCpuTemp" Content="{DynamicResource Stress.InstallDriver}" Margin="0,6,0,0" Padding="14,4"
                                        Click="InstallPawnIo_Click"
                                        ToolTip="{DynamicResource Stress.InstallDriverTip}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                            <views:LineChartControl x:Name="CpuPowerChart"
                                                    Title="{DynamicResource Stress.Chart.CpuPower}" Unit="W" SampleIntervalSeconds="2"/>
                            <StackPanel x:Name="CpuPowerOverlay" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Stress.NoSensorDriver}"
                                           Foreground="{DynamicResource ChartNoDataBrush}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="InstallDriverButtonCpuPower" Content="{DynamicResource Stress.InstallDriver}" Margin="0,6,0,0" Padding="14,4"
                                        Click="InstallPawnIo_Click"
                                        ToolTip="{DynamicResource Stress.InstallDriverTip}"/>
                            </StackPanel>
                        </Grid>
                        <views:LineChartControl x:Name="GpuTempChart" Grid.Row="1" Grid.Column="0"
                                                Title="{DynamicResource Stress.Chart.GpuTemp}" Unit="℃" Margin="0,0,6,0" SampleIntervalSeconds="2"/>
                        <views:LineChartControl x:Name="GpuPowerChart" Grid.Row="1" Grid.Column="1"
                                                Title="{DynamicResource Stress.Chart.GpuPower}" Unit="W" Margin="6,0,0,0" SampleIntervalSeconds="2"/>
                    </Grid>
                    <!-- 传感器口径：每路一行「指标 ← 硬件 / 传感器」，不可用的行注明状态 -->
                    <TextBlock x:Name="SensorHintText" Margin="0,8,0,0" TextWrapping="Wrap"
                               FontSize="11" LineHeight="17"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 运行日志：Consolas（LogBox 惯例同键盘页），自动滚底，上限 500 条；
                 圆角 = 外套圆角 Border（TextBox 去边框去底色嵌入） -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,12,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stress.LogTitle}" FontWeight="SemiBold" FontSize="13"/>
                    <Border Margin="0,6,0,0" CornerRadius="6"
                            Background="{DynamicResource SurfaceBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="LogBox" Height="110" Padding="6,4"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 通过区 -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                <Button x:Name="PassButton" Content="{DynamicResource Stress.Pass}"
                        FontSize="14" FontWeight="SemiBold" Padding="16,7" Click="PassButton_Click"
                        ToolTip="{DynamicResource Stress.PassTip}"/>
                <TextBlock x:Name="PassHintText" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
