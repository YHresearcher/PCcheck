<UserControl x:Class="YanJi.Plugin.Summary.SummaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Sum.Title}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Sum.Subtitle}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <TextBlock x:Name="OverallText" Grid.Row="1" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock x:Name="PhrasingText" Grid.Row="2" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <!-- Dòng "An Tâm nhắn bạn": chỉ hiện khi kết quả cho phép (máy đạt hoặc
             cảnh báo nhẹ), không hiện khi có lỗi nghiêm trọng, chưa đủ dữ liệu,
             hoặc kỹ thuật viên đánh dấu không mua — để không làm nhẹ cảnh báo.
             Code-behind đặt Visibility = Collapsed khi không được hiện. -->
        <TextBlock x:Name="AnTamNoteText" Grid.Row="3" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
        <!-- Thẻ Sức khỏe & Rủi ro, dời từ Dashboard sang đây (2026-11-05).
             Chỉ giữ hộp lý do chính (mascot + lý do chặn/cảnh báo đầu tiên):
             banner kết luận KHÔNG dời theo vì trang này đã có OverallText ở trên,
             danh sách rủi ro cố định + dòng trạng thái đã bỏ theo ý user,
             nút "Xem báo cáo" bỏ vì đang ở ngay trang Báo cáo.
             Nhãn hộp đổi thành "Lý do chính" để khỏi trùng dòng
             "An Tâm nhắn bạn" (câu thơ) ở trên cùng trang. -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Sum.HealthTitle}"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <Border Background="{DynamicResource SubtleBgBrush}"
                        CornerRadius="12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="HealthMascot" Grid.Column="0" Source="pack://application:,,,/Assets/mascot-new.png"
                               Width="140" Height="105" Stretch="Uniform"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Sum.MainReason}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock x:Name="HealthReasonText" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,8">
            <Button x:Name="MarkLoaiButton" Content="{DynamicResource Sum.MarkLoai}" Padding="16,7"
                    Click="MarkLoaiButton_Click"
                    ToolTip="{DynamicResource Sum.MarkTip}"/>
        </StackPanel>

        <!-- Lưu hồ sơ phiên: 1 máy = 1 thư mục riêng trên USB, không ghi đè.
             Thư mục: <thư mục app>\KetQua\<S/N>_<yyyyMMdd_HHmmss>\ (xem SummaryPage.SaveSessionButton_Click).
             S/N để trống vẫn lưu được, tên thư mục dùng KhongCoSN, để máy mất tem vẫn có hồ sơ. -->
        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Sum.Serial}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="SerialBox" Width="220" Margin="8,0,0,0" Padding="6,4"
                         ToolTip="{DynamicResource Sum.SerialTip}"/>
                <Button x:Name="SaveSessionButton" Content="{DynamicResource Sum.Save}" Margin="8,0,0,0" Padding="16,7"
                        Click="SaveSessionButton_Click"
                        ToolTip="{DynamicResource Sum.SaveTip}"/>
            </StackPanel>
            <TextBlock x:Name="SaveStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Sum.TechTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ModuleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Grade}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
