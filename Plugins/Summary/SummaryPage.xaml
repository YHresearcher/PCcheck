<UserControl x:Class="YanJi.Plugin.Summary.SummaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kết luận tổng" FontSize="18" FontWeight="Bold"/>
        <TextBlock x:Name="OverallText" Grid.Row="1" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock x:Name="PhrasingText" Grid.Row="2" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,8">
            <Button x:Name="ChangePhrasingButton" Content="Đổi cách nói" Padding="16,7"
                    Click="ChangePhrasingButton_Click"
                    ToolTip="Đổi sang 1 cách nói khác cho cùng 1 kết luận tổng, kết luận không đổi"/>
            <Button x:Name="MarkLoaiButton" Content="Đánh dấu loại máy này" Margin="8,0,0,0" Padding="16,7"
                    Click="MarkLoaiButton_Click"
                    ToolTip="Máy hỏng nặng, không sửa để bán thì bấm đây để kết luận tổng thành LOẠI. Bấm lại để bỏ đánh dấu."/>
        </StackPanel>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Kết luận từng module" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ModuleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Grade}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Ghi chú: kết luận tổng tự động chỉ tính từ kết luận từng module đã có. Hiện tại chỉ module Đối chiếu cấu hình (kết luận ổ) và Cổng kết nối &amp; Sạc (kết luận sạc) có mức Cảnh báo / Chặn riêng; các module còn lại chỉ tính theo đã cho qua / chưa cho qua, chưa chấm điểm pin, nhiệt độ hay tốc độ ổ vì shop chưa chốt ngưỡng cho các mục đó. LOẠI không tự sinh ra từ test — kỹ thuật viên tự đánh dấu khi máy hỏng nặng không sửa để bán."
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
