<UserControl x:Class="YanJi.Plugin.Summary.SummaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Kết luận mua máy — mua được hay không" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Dành cho người mua: chỉ cần đọc 2 dòng dưới là đủ" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <TextBlock x:Name="OverallText" Grid.Row="1" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock x:Name="PhrasingText" Grid.Row="2" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <!-- Dòng "An Tâm nhắn bạn": chỉ hiện khi kết quả cho phép (máy đạt hoặc
             cảnh báo nhẹ), không hiện khi có lỗi nghiêm trọng, chưa đủ dữ liệu,
             hoặc kỹ thuật viên đánh dấu không mua — để không làm nhẹ cảnh báo.
             Code-behind đặt Visibility = Collapsed khi không được hiện. -->
        <TextBlock x:Name="AnTamNoteText" Grid.Row="3" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,8">
            <Button x:Name="MarkLoaiButton" Content="Đánh dấu không mua máy này" Padding="16,7"
                    Click="MarkLoaiButton_Click"
                    ToolTip="Máy hỏng nặng, không nên mua thì bấm đây để kết luận thành KHÔNG MUA. Bấm lại để bỏ đánh dấu."/>
            <Button x:Name="VisitShopButton" Content="Tham quan shop" Margin="8,0,0,0" Padding="16,7"
                    Click="VisitShopButton_Click"
                    ToolTip="Mở website vitinhantam.com trong trình duyệt mặc định"/>
        </StackPanel>

        <!-- Lưu hồ sơ phiên: 1 máy = 1 thư mục riêng trên USB, không ghi đè.
             Thư mục: <thư mục app>\KetQua\<S/N>_<yyyyMMdd_HHmmss>\ (xem SummaryPage.SaveSessionButton_Click).
             S/N để trống vẫn lưu được, tên thư mục dùng KhongCoSN, để máy mất tem vẫn có hồ sơ. -->
        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="S/N máy:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="SerialBox" Width="220" Margin="8,0,0,0" Padding="6,4"
                         ToolTip="Số serial / service_tag của máy đang test, dùng để đặt tên thư mục hồ sơ. Để trống vẫn lưu được."/>
                <Button x:Name="SaveSessionButton" Content="Lưu hồ sơ phiên này" Margin="8,0,0,0" Padding="16,7"
                        Click="SaveSessionButton_Click"
                        ToolTip="Lưu kết luận + nhận xét + kết quả từng module + kết quả đo ổ (nếu có) vào 1 thư mục riêng trên USB, không ghi đè hồ sơ máy trước"/>
            </StackPanel>
            <TextBlock x:Name="SaveStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dành cho kỹ thuật viên — chi tiết từng module (vì sao ra kết luận trên)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ModuleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Grade}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Ghi chú: câu kết luận lấy từ file Phrasings.json (không viết cố định trong C#), chọn theo thứ tự ưu tiên: lỗi nghiêm trọng → lỗi chức năng → cảnh báo linh kiện → thiếu dữ liệu → máy đạt. Thiếu dữ liệu quan trọng thì không được xếp vào nhóm tốt chỉ vì không phát hiện lỗi. Hiện tại chỉ module Đối chiếu cấu hình (kết luận ổ, theo mức độ nghiêm trọng của lỗi trước rồi mới xét sức khỏe) và Cổng kết nối &amp; Sạc (kết luận sạc) có mức Cảnh báo / Chặn riêng; các module còn lại chỉ tính theo đã cho qua / chưa cho qua. Câu pin / CPU-GPU / ngoại vi / kết hợp B-C đã có sẵn trong file, nhưng chưa tự chọn vì chưa có tín hiệu (cần % chai pin, nhiệt/throttling, tick xác nhận tay) — không đoán từ dữ liệu không có. KHÔNG MUA không tự sinh ra từ test — kỹ thuật viên tự đánh dấu khi máy hỏng nặng không nên mua. Dòng 'An Tâm nhắn bạn' chỉ hiện khi máy đạt hoặc cảnh báo nhẹ, không làm nhẹ cảnh báo nghiêm trọng. Hai quy tắc không nói quá: số liệu SMART không đọc được thì hiện Không rõ, không được biến thành ổ khỏe; một bài stress ngắn đạt chỉ chứng minh máy chạy được chừng đó phút ở tải cao, không chứng minh ổn định lâu dài."
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
