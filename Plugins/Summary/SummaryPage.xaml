<UserControl x:Class="YanJi.Plugin.Summary.SummaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Trang Báo cáo kiểu Mac: chồng các thẻ trắng — kết luận (nền vàng nhạt),
         tiến độ, sức khỏe &amp; rủi ro, kết quả chi tiết (+ lưu hồ sơ ở cuối thẻ),
         pin &amp; lưu trữ, An Tâm nhắn bạn. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBgBrush}">
        <StackPanel Margin="16">
            <!-- Thẻ kết luận: tiêu đề + kết luận 18pt trên nền vàng nhạt +
                 câu thân thiện + dòng chú thích. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="pack://application:,,,/Assets/12_check_outline_orange.png" Width="34" Height="34" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource Sum.ReportTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="12" Padding="12">
                        <TextBlock x:Name="OverallText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="PhrasingText" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{DynamicResource Sum.ReportNote}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <!-- Thẻ tiến độ: x/y hạng mục + thanh tiến độ xanh + trạng thái
                 + nút tiếp tục kiểm tra khi còn bài chưa xong. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Sum.ProgressTitle}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="ProgressCountText" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"/>
                    </DockPanel>
                    <ProgressBar x:Name="SessionProgressBar" Height="8" Minimum="0" Maximum="9" Value="0" Foreground="#18AD4D" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ProgressStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="ContinueButton" Content="{DynamicResource Sum.ContinueTest}" Padding="16,7" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Click="ContinueButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <!-- Thẻ Sức khỏe & Rủi ro, dời từ Dashboard sang đây (2026-11-05).
                 Chỉ giữ hộp lý do chính (mascot + lý do chặn/cảnh báo đầu tiên):
                 banner kết luận KHÔNG dời theo vì thẻ kết luận ở trên đã có,
                 danh sách rủi ro cố định + dòng trạng thái đã bỏ theo ý user.
                 Nhãn hộp là "Lý do chính" để khỏi trùng dòng
                 "An Tâm nhắn bạn" (câu thơ) ở thẻ cuối trang. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sum.HealthTitle}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource SubtleBgBrush}"
                            CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="HealthMascot" Grid.Column="0" Source="pack://application:,,,/Assets/mascot-new.png"
                                   Width="140" Height="105" Stretch="Uniform"
                                   Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Sum.MainReason}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock x:Name="HealthReasonText" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="MarkLoaiButton" Content="{DynamicResource Sum.MarkLoai}" Padding="16,7"
                        Click="MarkLoaiButton_Click"
                        ToolTip="{DynamicResource Sum.MarkTip}"/>
            </StackPanel>
            <!-- Thẻ kết quả chi tiết: mỗi module 1 hàng (tên + mức + ghi chú),
                 gạch chia giữa các hàng; lưu hồ sơ phiên ở cuối thẻ, như nút
                 Xuất báo cáo của Mac. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sum.DetailTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ModuleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Grade}" FontWeight="Medium" Foreground="{Binding GradeBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <Separator Margin="0,8,0,8" Opacity="0.45"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Lưu hồ sơ phiên: 1 máy = 1 thư mục riêng trên USB, không ghi đè.
                         Thư mục: <thư mục app>\KetQua\<S/N>_<yyyyMMdd_HHmmss>\ (xem SummaryPage.SaveSessionButton_Click).
                         S/N để trống vẫn lưu được, tên thư mục dùng KhongCoSN, để máy mất tem vẫn có hồ sơ. -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Sum.Serial}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox x:Name="SerialBox" Width="220" Margin="8,0,0,0" Padding="6,4"
                                     ToolTip="{DynamicResource Sum.SerialTip}"/>
                            <Button x:Name="SaveSessionButton" Content="{DynamicResource Sum.Save}" Margin="8,0,0,0" Padding="16,7"
                                    Click="SaveSessionButton_Click"
                                    ToolTip="{DynamicResource Sum.SaveTip}"/>
                        </StackPanel>
                        <TextBlock x:Name="SaveStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Thẻ Pin & Lưu trữ kiểu Mac: % pin còn lại + số ổ nhận diện
                 + dòng lưu ý về SMART. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sum.PinStorageTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="PinLineText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DrivesLineText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Sum.SmartNote}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <!-- Thẻ An Tâm nhắn bạn: chỉ hiện khi kết quả cho phép (máy đạt hoặc
                 cảnh báo nhẹ), không hiện khi có lỗi nghiêm trọng, chưa đủ dữ liệu,
                 hoặc kỹ thuật viên đánh dấu không mua — để không làm nhẹ cảnh báo.
                 Code-behind đặt Visibility của cả thẻ = Collapsed khi không được hiện. -->
            <Border x:Name="AnTamCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="♥" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Sum.AnTamTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="AnTamNoteText" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
