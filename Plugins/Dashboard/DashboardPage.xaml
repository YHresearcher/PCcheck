<UserControl x:Class="YanJi.Plugin.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReferenceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Nút hành động lớn: bo 18 nổi 3D kiểu Mac (RaisedButton18). -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource RaisedButton18}">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Ô tóm tắt kiểu Mac: nền WindowBg, bo 12, padding 12. -->
        <Style x:Key="SummaryTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <!-- Viên thuốc trạng thái kiểu Mac: nền = 8% màu trạng thái, bo 12. -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
        <!-- 1 hàng danh sách bài kiểm tra kiểu Mac: icon trạng thái 24 +
             tên + viên thuốc trạng thái, gạch chia mờ giữa các hàng. -->
        <DataTemplate x:Key="TestListRowTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Dấu trạng thái: ảnh icon thật khi có StatusIcon
                         (đạt / lỗi / chưa thử); cảnh báo giữ dấu "!" chữ. -->
                    <Grid Grid.Column="0">
                        <Image Source="{Binding StatusIcon}" Width="20" Height="20" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIcon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding Indicator}"
                                   FontSize="17" Foreground="{Binding StatusBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIcon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="7,0,0,0"/>
                    <Border Grid.Column="2" Style="{StaticResource StatusPill}"
                            Background="{Binding PillBrush}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Medium"
                                   Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Separator Margin="0,7,0,0" Opacity="0.45"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBgBrush}">
        <StackPanel Margin="20,18,20,12">
            <!-- Header kiểu Mac: tiêu đề lớn 30 + phụ đề, 2 nút bên phải. -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Dash.OverviewTitle}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource Dash.OverviewSubtitle}" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="RefreshButton_Click" Padding="12,8" Margin="0,0,8,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/18_refresh_dark.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{DynamicResource Dash.Refresh}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="SummaryButton_Click" Padding="12,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/19_download_orange.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{DynamicResource Dash.Export}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Thẻ Thông tin máy kiểu Mac: ảnh + vạch chia + tên/dòng spec
                 + cột phải 5 ô tóm tắt (RAM, SSD, Pin, trạng thái pin, hệ điều hành). -->
            <Border Style="{StaticResource ReferenceCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="pack://application:,,,/Assets/01_laptop_orange.png" Width="34" Height="34" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource Dash.DeviceTitle}" Style="{StaticResource CardHeading}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="213"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="390"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="pack://application:,,,/Assets/laptop-preview-2026.png"
                               Width="200" Height="190" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,13,0" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock x:Name="MachineText" Text="{DynamicResource Dash.MachineTitle}"
                                       FontWeight="Bold" FontSize="22" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Dash.SysSpecs}" Style="{StaticResource Muted}" Margin="0,3,0,10"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Assets/01_laptop_orange.png" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="BrandModelText" Grid.Column="1" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Assets/17_info_gray.png" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="SerialText" Grid.Column="1" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Assets/03_cpu_chip_gray.png" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="CpuText" Grid.Column="1" Text="{DynamicResource Dash.CpuInit}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Assets/04_layers_gray.png" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="GpuText" Grid.Column="1" Text="{DynamicResource Dash.GpuInit}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Assets/08_lightning_orange.png" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="TempText" Grid.Column="1" Text="{DynamicResource Dash.TempReading}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Button Content="{DynamicResource Dash.ViewConfig}" Click="HardwareButton_Click"
                                    HorizontalAlignment="Left" Padding="8,5" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SummaryTile}" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/05_ram_orange.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Dash.TileRam}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="RamTileValue" Text="{DynamicResource Dash.RamInit}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SummaryTile}" Margin="5,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/06_ssd_orange.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Dash.TileSsd}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="SsdTileValue" Text="{DynamicResource Dash.StorageInit}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SummaryTile}" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/07_battery_green.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Dash.TileBattery}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="BatteryTileValue" Text="{DynamicResource Dash.CpuUnread}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SummaryTile}" Margin="5,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/08_lightning_orange.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Dash.TileBatteryState}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="BatteryStateTileValue" Text="{DynamicResource Dash.CpuUnread}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource SummaryTile}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/10_settings_orange.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Dash.TileOs}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="OsTileValue" Text="{DynamicResource Dash.CpuUnread}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Thẻ sức khỏe chung: mỗi ổ 1 thanh pin riêng, pin 1
                 thanh riêng, cùng 1 hàng, căn giữa; thanh hình
                 battery indicator bo tròn (thân + đầu cực + vệt
                 bóng + gradient 3D). Thanh ổ xanh dương, thanh
                 pin cam (màu gốc app) để phân biệt. -->
            <Border Style="{StaticResource ReferenceCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash.HealthTitle}" Style="{StaticResource CardHeading}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DriveEmptyText" Text="{DynamicResource Dash.DriveEmpty}" Style="{StaticResource Muted}"/>
                    <WrapPanel x:Name="RingsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Hàng kết quả nhanh + danh sách bài kiểm tra, 2 thẻ cạnh
                 nhau kiểu Mac (tóm tắt trái, danh sách phải). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Thẻ kết quả kiểm tra nhanh: số pass lớn + thanh tiến độ
                     xanh + 3 ô số + nút cam lớn vào wizard. -->
                <Border Grid.Column="0" Style="{StaticResource ReferenceCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/Assets/12_check_outline_orange.png" Width="34" Height="34" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{DynamicResource Dash.QuickTitle}" Style="{StaticResource CardHeading}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Dash.PassedPrefix}" FontSize="19" FontWeight="Bold" VerticalAlignment="Baseline"/>
                            <TextBlock x:Name="PassedCountText" Text="0/8" FontSize="25" FontWeight="Bold" Foreground="#18AD4D" Margin="5,0,5,0" VerticalAlignment="Baseline"/>
                            <TextBlock Text="{DynamicResource Dash.PassedSuffix}" FontSize="19" FontWeight="Bold" VerticalAlignment="Baseline"/>
                        </StackPanel>
                        <ProgressBar x:Name="SummaryProgressBar" Height="8" Minimum="0" Maximum="8" Value="0" Foreground="#18AD4D" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="11" Padding="10" Margin="0,0,5,0" Background="#0F18AD4D">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/21_status_pass_green.png" Width="26" Height="26" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="PassTileCount" Text="0" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource Dash.Status.Pass}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="11" Padding="10" Margin="5,0,5,0" Background="#0FD33D42">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/23_status_error_red.png" Width="26" Height="26" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="FailTileCount" Text="0" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource Dash.Status.Fail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="11" Padding="10" Margin="5,0,0,0" Background="#0F888080">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/22_status_not_tested_gray.png" Width="26" Height="26" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LeftTileCount" Text="0" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource Dash.Status.Untried}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button x:Name="StartButton" Style="{StaticResource ActionButton}"
                                Background="{DynamicResource ButtonPrimaryBgBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Foreground="White" Click="StartButton_Click"
                                ToolTip="{DynamicResource Dash.RunDetailTip}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/24_arrow_right_dark.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource Dash.ContinueDetail}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- Thẻ danh sách bài kiểm tra: 2 cột, vạch chia giữa,
                     mỗi hàng icon trạng thái + tên + viên thuốc. -->
                <Border Grid.Column="2" Style="{StaticResource ReferenceCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/Assets/13_checklist_orange.png" Width="34" Height="34" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TestListTitleText" Style="{StaticResource CardHeading}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="TestListLeft" Grid.Column="0" Margin="0,0,7,0"
                                          ItemTemplate="{StaticResource TestListRowTemplate}"/>
                            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" Margin="0,4,0,4"/>
                            <ItemsControl x:Name="TestListRight" Grid.Column="2" Margin="7,0,0,0"
                                          ItemTemplate="{StaticResource TestListRowTemplate}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
