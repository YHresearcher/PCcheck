<UserControl x:Class="YanJi.Plugin.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReferenceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="20,18,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Xin chào! 👋" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Cùng An Tâm kiểm tra tổng thể chiếc PC của bạn nhé!"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻  Kiểm tra tiếp" VerticalAlignment="Center"
                        Click="StartButton_Click" Padding="14,9"/>
            </Grid>

            <!-- Một cột duy nhất: thẻ máy + kết quả nhanh + nút hành động.
                 Thẻ Sức khỏe & Rủi ro đã dời sang trang Báo cáo (2026-11-05). -->
            <Grid x:Name="DashboardBody" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0">
                    <!-- Hình máy + cấu hình thật, tương ứng card MacBook ở ảnh chuẩn. -->
                    <Border Style="{StaticResource ReferenceCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="213"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/Assets/laptop-preview-2026.png"
                                   Width="200" Height="190" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,13,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MachineText" Text="PC / Laptop đang kiểm tra"
                                           FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/>
                                <TextBlock Text="Thông số hệ thống" Style="{StaticResource Muted}" Margin="0,3,0,10"/>
                                <TextBlock x:Name="CpuText" Text="CPU: Chưa đọc" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="RamText" Text="RAM: Chưa đọc" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="GpuText" Text="GPU: Chưa đọc" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="StorageText" Text="SSD / HDD: Chưa đọc" FontSize="12" TextWrapping="Wrap"/>
                                <Button Content="Xem cấu hình chi tiết →" Click="HardwareButton_Click"
                                        HorizontalAlignment="Left" Padding="8,5" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dùng trạng thái từ module, không làm giả 12/12 đạt. -->
                    <Border Style="{StaticResource ReferenceCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Kết quả kiểm tra nhanh"
                                           Style="{StaticResource CardHeading}"/>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource NavSelectedBrush}"
                                        CornerRadius="16" Padding="10,6">
                                    <TextBlock x:Name="ProgressText" Text="0/8 mục đã thử" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </DockPanel>
                            <ItemsControl x:Name="QuickTestList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Margin="0,2,0,2" Padding="7,5"
                                                Background="{Binding RowBrush}" ToolTip="{Binding Detail}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding IconBackground}"
                                                        Width="27" Height="27" CornerRadius="7">
                                                    <TextBlock Text="{Binding Icon}" FontSize="16"
                                                               Foreground="{Binding IconBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                           FontSize="11" Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Indicator}"
                                                           FontSize="17" Foreground="{Binding StatusBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Hàng nút đúng ảnh chuẩn: không nằm dưới bảng dài riêng lẻ -->
                    <Border Style="{StaticResource ReferenceCard}" Padding="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.75*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource ActionButton}"
                                    Content="▶  Kiểm tra chi tiết" Background="{DynamicResource AccentBrush}"
                                    Foreground="White" Click="StartButton_Click"
                                    ToolTip="Bắt đầu hoặc tiếp tục wizard; không tự động chạy test khi khởi động."/>
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}"
                                    Content="▤  Xuất báo cáo" Click="SummaryButton_Click"
                                    ToolTip="Mở trang Tổng kết để lưu hồ sơ kiểm tra thực tế."/>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>