<UserControl x:Class="YanJi.Plugin.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReferenceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Nút hành động lớn: bo 18 nổi 3D kiểu Mac (RaisedButton18). -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource RaisedButton18}">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="20,18,20,12">
            <!-- 3 cột: sidebar (host) | phần cứng 2/3 | kết quả nhanh 1/3.
                 Thẻ Sức khỏe & Rủi ro đã dời sang trang Báo cáo (2026-11-05). -->
            <Grid x:Name="DashboardBody">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột phần cứng: thẻ máy (tóm tắt) + thẻ sức khỏe ổ. -->
                    <StackPanel Grid.Column="0">
                    <!-- Hình máy + cấu hình thật, tương ứng card MacBook ở ảnh chuẩn. -->
                    <Border Style="{StaticResource ReferenceCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="213"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/Assets/laptop-preview-2026.png"
                                   Width="200" Height="190" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,13,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MachineText" Text="{DynamicResource Dash.MachineTitle}"
                                           FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Dash.SysSpecs}" Style="{StaticResource Muted}" Margin="0,3,0,10"/>
                                <TextBlock x:Name="BrandModelText" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed"/>
                                <TextBlock x:Name="SerialText" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed"/>
                                <TextBlock x:Name="CpuText" Text="{DynamicResource Dash.CpuInit}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="RamText" Text="{DynamicResource Dash.RamInit}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="GpuText" Text="{DynamicResource Dash.GpuInit}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="StorageText" Text="{DynamicResource Dash.StorageInit}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock x:Name="OsText" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed"/>
                                <TextBlock x:Name="BatteryText" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TempText" Text="{DynamicResource Dash.TempReading}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <Button Content="{DynamicResource Dash.ViewConfig}" Click="HardwareButton_Click"
                                        HorizontalAlignment="Left" Padding="8,5" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Thẻ sức khỏe chung: mỗi ổ 1 vòng donut lớn riêng, pin 1
                         vòng riêng, cùng 1 hàng, căn giữa; thông tin ghi BÊN
                         TRONG vòng (tiêu đề SSD/PIN + tên ổ + dòng sức khỏe),
                         không còn nội dung bên dưới. Vòng ổ xanh dương, vòng
                         pin cam (màu gốc app) để phân biệt. -->
                    <Border Style="{StaticResource ReferenceCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash.HealthTitle}" Style="{StaticResource CardHeading}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DriveEmptyText" Text="{DynamicResource Dash.DriveEmpty}" Style="{StaticResource Muted}"/>
                            <WrapPanel x:Name="RingsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cột kết quả nhanh: 8 hàng, giữ nguyên nội dung. -->
                <Border Grid.Column="2" Style="{StaticResource ReferenceCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Dash.QuickTitle}"
                                       Style="{StaticResource CardHeading}" FontSize="17"/>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource NavSelectedBrush}"
                                        CornerRadius="16" Padding="10,6">
                                    <TextBlock x:Name="ProgressText" Text="{DynamicResource Dash.ProgressInit}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </DockPanel>
                            <ItemsControl x:Name="QuickTestList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Margin="0,2,0,2" Padding="7,5"
                                                Background="{Binding RowBrush}" ToolTip="{Binding Detail}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding IconBackground}"
                                                        Width="27" Height="27" CornerRadius="7">
                                                    <Grid>
                                                        <!-- Icon ảnh thật (bộ 24 icon Mac) khi hàng có IconPath;
                                                             chưa có icon thì giữ ký tự như cũ. -->
                                                        <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding Icon}" FontSize="16"
                                                                   Foreground="{Binding IconBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                           FontSize="11" Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <!-- Dấu trạng thái: ảnh icon thật khi có StatusIcon
                                                     (đạt / lỗi / chưa thử); cảnh báo giữ dấu "!" chữ. -->
                                                <Grid Grid.Column="3">
                                                    <Image Source="{Binding StatusIcon}" Width="20" Height="20" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusIcon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="{Binding Indicator}"
                                                               FontSize="17" Foreground="{Binding StatusBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusIcon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Hàng nút: bo 18 nổi 3D kiểu Mac, full chiều rộng. -->
                <Border Grid.Row="1" Style="{StaticResource ReferenceCard}" Padding="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.75*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource ActionButton}"
                                    Background="{DynamicResource ButtonPrimaryBgBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Foreground="White" Click="StartButton_Click"
                                    ToolTip="{DynamicResource Dash.RunDetailTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/24_arrow_right_dark.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{DynamicResource Dash.RunDetail}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}"
                                    Click="SummaryButton_Click"
                                    ToolTip="{DynamicResource Dash.ExportTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/19_download_orange.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{DynamicResource Dash.Export}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>