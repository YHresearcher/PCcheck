<UserControl x:Class="YanJi.Plugin.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="DashboardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DashboardMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CircleControl" TargetType="Button">
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="74"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Round" Background="{TemplateBinding Background}"
                                CornerRadius="37" BorderThickness="1" BorderBrush="#33FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Round" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Round" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Xin chào! 👋" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Cùng An Tâm kiểm tra tổng thể chiếc PC của bạn nhé!"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻  Kiểm tra tiếp" Padding="16,10"
                        Click="StartButton_Click" VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="DashboardBody" Grid.Row="1" SizeChanged="DashboardBody_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.88*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="💻  Thiết bị đang kiểm tra" Style="{StaticResource DashboardTitle}"/>
                            <TextBlock Text="Thông số máy được đọc ở mục Đối chiếu cấu hình."
                                       Style="{StaticResource DashboardMuted}" Margin="0,8,0,12"/>
                            <TextBlock x:Name="MachineText" FontSize="16" FontWeight="SemiBold"
                                       Text="Đang nhận diện thiết bị..." TextWrapping="Wrap"/>
                            <TextBlock x:Name="StorageText" Text="SSD / HDD: Chưa đọc"
                                       Style="{StaticResource DashboardMuted}" Margin="0,8,0,0"/>
                            <Button Content="Xem thông tin phần cứng →" Click="HardwareButton_Click"
                                    HorizontalAlignment="Left" Padding="12,8" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="✅  Kết quả kiểm tra nhanh" Style="{StaticResource DashboardTitle}"
                                           DockPanel.Dock="Left"/>
                                <Border Background="{DynamicResource NavSelectedBrush}"
                                        CornerRadius="12" Padding="8,4" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ProgressText" Text="0/0 mục" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                            <ItemsControl x:Name="QuickTestList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontSize="16"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                           FontSize="11" Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DashboardRight" Grid.Column="2" Grid.Row="0">
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="🛡  Đánh giá mua máy" Style="{StaticResource DashboardTitle}"/>
                            <Border Background="{DynamicResource SubtleBgBrush}" CornerRadius="11"
                                    Padding="12" Margin="0,12,0,12">
                                <TextBlock x:Name="OverallText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="An Tâm nhắn bạn 🧡" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Text="Chưa thử không được tính là đạt. Chi tiết xem trang Tổng kết."
                                       Style="{StaticResource DashboardMuted}" Margin="0,12,0,0"/>
                            <Button Content="Xem kết luận chi tiết →" Click="SummaryButton_Click"
                                    HorizontalAlignment="Left" Padding="12,8" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Vi tính An Tâm" Style="{StaticResource DashboardTitle}"/>
                            <Border Background="{DynamicResource NavSelectedBrush}" CornerRadius="8"
                                    Padding="10,5" HorizontalAlignment="Left" Margin="0,10,0,10">
                                <TextBlock Text="🛡 Bảo hành 6 tháng nguyên máy"
                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            <TextBlock Text="📍 Chi nhánh 1: 52 Nguyễn Cửu Vân, P. Long An, T. Tây Ninh"
                                       Style="{StaticResource DashboardMuted}" Margin="0,0,0,8"/>
                            <TextBlock Text="📍 Chi nhánh 2: 218/3 đường số 11, phường Thủ Đức, TP. HCM"
                                       Style="{StaticResource DashboardMuted}" Margin="0,0,0,8"/>
                            <TextBlock Text="🌐 vitinhantam.com" Style="{StaticResource DashboardMuted}"/>
                            <Button Content="↗  Tham quan shop" Click="ShopButton_Click"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Background="{DynamicResource SurfaceBgBrush}"
                                    Padding="14,10" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Công cụ nhanh" Style="{StaticResource DashboardTitle}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Sức khỏe thiết bị" Click="HealthButton_Click" Padding="12,7" Margin="0,0,8,8"/>
                                <Button Content="Thư mục báo cáo" Click="ReportsButton_Click" Padding="12,7" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,28,0">
                        <Button x:Name="StartButton" Content="▶" Style="{StaticResource CircleControl}"
                                Background="{DynamicResource AccentBrush}" Click="StartButton_Click"
                                ToolTip="Bắt đầu hoặc tiếp tục wizard kiểm tra, không tự chạy khi mở app."/>
                        <TextBlock x:Name="StartCaption" Text="BẮT ĐẦU" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Button Content="■" Style="{StaticResource CircleControl}" Background="#C42B1C"
                                Click="StopButton_Click"
                                ToolTip="Dừng các bài test nặng đang chạy: CPU/GPU stress, đo ổ. Có xác minh tiến trình còn sống."/>
                        <TextBlock Text="DỪNG TEST NẶNG" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Inspection Control" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Test chỉ chạy khi bạn chủ động bắt đầu. Hãy kiểm tra kỹ từng mục nha!"
                                   Style="{StaticResource DashboardMuted}" Margin="0,5,0,10"/>
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                                     Height="9" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>