<UserControl x:Class="YanJi.Plugin.Dashboard.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Tổng quan" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Vi Tính An Tâm • Máy bán ra đã kiểm tra toàn bộ, bảo hành 6 tháng" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <TextBlock x:Name="ProgressText" Grid.Row="1" FontSize="14" Margin="0,12,0,0"/>
        <TextBlock x:Name="OverallText" Grid.Row="2" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ReasonText" Grid.Row="3" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel Grid.Row="4">
            <Button x:Name="StartButton" Content="Bắt đầu kiểm tra máy" Padding="16,10" HorizontalAlignment="Left"
                    Click="StartButton_Click"
                    ToolTip="Vào chế độ kiểm tra tập trung: mỗi lần chỉ 1 bài test, có quay lại bài trước, dừng tất cả và thoát wizard. Chưa xong bài nào thì bắt đầu từ bài đầu tiên, đã xong vài bài thì tiếp tục từ bài chưa xong."/>
            <Button Content="Xem thông tin phần cứng (Đối chiếu cấu hình)" Padding="16,7" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Click="HardwareButton_Click"
                    ToolTip="Xem cấu hình máy đã thu thập (CPU, GPU, RAM, ổ, pin). Đây là khu vực thông tin, không phải bài test trong wizard."/>
            <Button Content="Xem sức khỏe thiết bị" Padding="16,7" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Click="HealthButton_Click"
                    ToolTip="Xem đánh giá theo mức độ nghiêm trọng từ kết quả các bài đã test, không phải bài test mới."/>
            <Button Content="Xem kết luận mua máy" Padding="16,7" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Click="SummaryButton_Click"
                    ToolTip="Tới trang Tổng kết: tiêu đề mua được hay không + câu nhận xét thân thiện + chi tiết từng module."/>
            <Button Content="Mở thư mục hồ sơ (KetQua)" Padding="16,7" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Click="ReportsButton_Click"
                    ToolTip="Mở thư mục chứa hồ sơ từng phiên test (mỗi máy 1 thư mục riêng, xem lại báo cáo cũ, nằm trong thư mục app (KetQua))."/>
            <TextBlock Text="Ghi chú: Dashboard không tự chọn câu nhận xét riêng — câu nhận xét thân thiện chỉ hiện ở trang Tổng kết, để 2 nơi không hiện 2 câu khác nhau cho cùng 1 kết luận. Vào wizard thì menu bên trái bị khóa, mỗi lần chỉ 1 bài test; bấm Thoát wizard ở thanh trên để mở lại menu, trạng thái test không mất."
                       TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
