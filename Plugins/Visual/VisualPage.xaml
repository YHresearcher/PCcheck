<UserControl x:Class="YanJi.Plugin.Visual.VisualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Trạng thái test:" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="Chưa test" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <TextBlock Text="Kiểm tra bằng mắt: vỏ, bản lề, phím, cổng, pin, dấu vết — những gì phần mềm không đo được. Chỉ tick những gì đã tận mắt kiểm tra. Không tick gì mà bấm cho qua nghĩa là ngoại quan không lỗi. Tick lỗi thì bấm cho qua vẫn ghi nhận lỗi vào kết luận (cảnh báo), trừ pin phồng thì bị chặn cho qua vì nguy hiểm."
                   TextWrapping="Wrap" Margin="0,8,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <TextBlock Text="Vỏ, bản lề &amp; màn hình" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <CheckBox x:Name="CaseCrackedCheck" Content="Vỏ nứt / móp / vỡ góc" Margin="0,0,0,4"/>
        <CheckBox x:Name="HingeCheck" Content="Bản lề lỏng" Margin="0,0,0,4"
                  ToolTip="Tick khi bản lề lỏng, đóng mở không chắc — bấm cho qua vẫn ghi nhận lỗi vào kết luận (cảnh báo)"/>
        <CheckBox x:Name="ScreenScratchesCheck" Content="Màn hình trầy / viền nứt" Margin="0,0,0,12"/>

        <TextBlock Text="Phím, cổng, pin &amp; dấu vết" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <CheckBox x:Name="KeyMissingCheck" Content="Phím bong / mất phím" Margin="0,0,0,4"/>
        <CheckBox x:Name="TrackpadVerifiedCheck" Content="Đã kiểm tra trackpad (hoặc máy không có trackpad)"
                  Margin="0,0,0,4" ToolTip="Chỉ chọn sau khi đã thử rê, nhấp, thao tác trackpad; PC không có trackpad thì chọn để xác nhận không áp dụng."/>
        <CheckBox x:Name="TrackpadFailCheck" Content="Trackpad không phản hồi / thao tác lỗi"
                  Margin="0,0,0,4" ToolTip="Tick khi trackpad có lỗi, kết quả sẽ được ghi nhận là cảnh báo."/>
        <CheckBox x:Name="PortDamagedCheck" Content="Cổng móp / gãy chân" Margin="0,0,0,4"/>
        <CheckBox x:Name="BatterySwollenCheck" Content="Pin phồng (vỏ / bàn phím đội lên) — chặn cho qua" Margin="0,0,0,4"
                  ToolTip="Pin phồng là nguy hiểm, không bán nguyên trạng: tick thì bị chặn cho qua giống ổ bị chặn, thay pin rồi kiểm tra lại"/>
        <CheckBox x:Name="OpenedSignCheck" Content="Thiếu ốc / tem rách / dấu mở máy" Margin="0,0,0,12"
                  ToolTip="Dấu hiệu máy đã mở / sửa trước đó mà không rõ lịch sử — cảnh báo để thương lượng và kiểm tra kỹ hơn"/>

        <TextBlock Text="Trầy xước" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <CheckBox x:Name="ScratchesCheck" Content="Trầy xước nhẹ (không ảnh hưởng chức năng)" Margin="0,0,0,12"
                  ToolTip="Tick khi máy có trầy nhẹ nhưng chức năng bình thường — bấm cho qua vẫn ghi nhận để thương lượng giá"/>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="PassButton" Content="Xác nhận không lỗi, cho qua" Click="PassButton_Click"
                    FontSize="14" FontWeight="SemiBold" Padding="16,7"
                    ToolTip="Đã kiểm tra ngoại quan bằng mắt rồi mới bấm; có tick lỗi thì bấm cho qua vẫn ghi nhận lỗi, không phải là 'không lỗi' (trừ pin phồng thì bị chặn)"/>
            <Button x:Name="ResetButton" Content="Đặt lại" Margin="8,3,2,3" Click="ResetButton_Click"
                    ToolTip="Bỏ hết tick và trạng thái cho qua, kiểm tra lại từ đầu"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
