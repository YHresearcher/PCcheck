<UserControl x:Class="YanJi.Plugin.Visual.VisualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="{DynamicResource Visual.StatusLabel}" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="{DynamicResource Visual.Status.NotTested}" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Visual.Intro}"
                   TextWrapping="Wrap" Margin="0,8,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <TextBlock Text="{DynamicResource Visual.Section.CaseScreen}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <CheckBox x:Name="CaseCrackedCheck" Content="{DynamicResource Visual.Item.CaseCracked}" Margin="0,0,0,4"/>
        <CheckBox x:Name="HingeCheck" Content="{DynamicResource Visual.Item.Hinge}" Margin="0,0,0,4"
                  ToolTip="{DynamicResource Visual.Tip.Hinge}"/>
        <CheckBox x:Name="ScreenScratchesCheck" Content="{DynamicResource Visual.Item.ScreenScratches}" Margin="0,0,0,12"/>

        <TextBlock Text="{DynamicResource Visual.Section.KeysPorts}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <CheckBox x:Name="KeyMissingCheck" Content="{DynamicResource Visual.Item.KeyMissing}" Margin="0,0,0,4"/>
        <CheckBox x:Name="TrackpadVerifiedCheck" Content="{DynamicResource Visual.Item.TrackpadVerified}"
                  Margin="0,0,0,4" ToolTip="{DynamicResource Visual.Tip.TrackpadVerified}"/>
        <CheckBox x:Name="TrackpadFailCheck" Content="{DynamicResource Visual.Item.TrackpadFail}"
                  Margin="0,0,0,4" ToolTip="{DynamicResource Visual.Tip.TrackpadFail}"/>
        <CheckBox x:Name="PortDamagedCheck" Content="{DynamicResource Visual.Item.PortDamaged}" Margin="0,0,0,4"/>
        <CheckBox x:Name="BatterySwollenCheck" Content="{DynamicResource Visual.Item.BatterySwollen}" Margin="0,0,0,4"
                  ToolTip="{DynamicResource Visual.Tip.BatterySwollen}"/>
        <CheckBox x:Name="OpenedSignCheck" Content="{DynamicResource Visual.Item.OpenedSign}" Margin="0,0,0,12"
                  ToolTip="{DynamicResource Visual.Tip.OpenedSign}"/>

        <TextBlock Text="{DynamicResource Visual.Section.Scratches}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <CheckBox x:Name="ScratchesCheck" Content="{DynamicResource Visual.Item.Scratches}" Margin="0,0,0,12"
                  ToolTip="{DynamicResource Visual.Tip.Scratches}"/>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="PassButton" Content="{DynamicResource Visual.PassButton}" Click="PassButton_Click"
                    FontSize="14" FontWeight="SemiBold" Padding="16,7"
                    ToolTip="{DynamicResource Visual.Tip.PassButton}"/>
            <Button x:Name="ResetButton" Content="{DynamicResource Visual.ResetButton}" Margin="8,3,2,3" Click="ResetButton_Click"
                    ToolTip="{DynamicResource Visual.Tip.ResetButton}"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
