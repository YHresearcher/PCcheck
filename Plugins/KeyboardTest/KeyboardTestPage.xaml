<UserControl x:Class="YanJi.Plugin.KeyboardTest.KeyboardTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 状态行：通过后变绿 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="{DynamicResource Keyboard.StatusLabel}" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="{DynamicResource Keyboard.NotTested}" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 操作行 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
            <Button x:Name="ResetButton" Content="{DynamicResource Keyboard.Reset}" Click="ResetButton_Click"
                    ToolTip="{DynamicResource Keyboard.ResetTip}"/>
            <Button x:Name="PassButton" Content="{DynamicResource Keyboard.Pass}" Margin="8,3,2,3" Click="PassButton_Click"
                    ToolTip="{DynamicResource Keyboard.PassTip}"/>
            <CheckBox x:Name="DeadKeyCheck" Content="{DynamicResource Keyboard.DeadKey}" Margin="16,0,0,0" VerticalAlignment="Center"
                      ToolTip="{DynamicResource Keyboard.DeadKeyTip}"/>
        </StackPanel>

        <!-- 进度行 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <ProgressBar x:Name="KeyProgress" Height="10" Minimum="0" Maximum="104"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="ProgressText" Text="{DynamicResource Keyboard.ProgressInitial}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{DynamicResource Keyboard.Hint}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- 键盘区：u 单位坐标在 code-behind 生成（Canvas 尺寸也在代码里设定），Viewbox 自适应缩放 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Width="Auto" Margin="0" Padding="14">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="KeyboardCanvas"/>
            </Viewbox>
        </Border>

        <!-- 按键历史 Log 区：Consolas（LogBox 惯例），自动滚底，上限 500 条；
             圆角 = 外套圆角 Border（TextBox 本身无圆角，去边框去底色嵌进去），与分组卡片/键帽一致 -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Keyboard.LogTitle}" FontWeight="SemiBold"/>
            <Border Margin="0,4,0,0" CornerRadius="6"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBox x:Name="LogBox" Height="120" Padding="6,4"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextBrush}"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
