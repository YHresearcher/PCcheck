<UserControl x:Class="YanJi.Plugin.ScreenDeadPixel.DeadPixelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <!-- 状态行：通过后变绿 -->
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="{DynamicResource Screen.StatusLabel}" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="{DynamicResource Screen.NotTested}" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 操作行：显示器选择 + 开始测试 + 确认通过 -->
        <WrapPanel Orientation="Horizontal" Margin="0,8" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Screen.MonitorLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonitorBox" Width="340" VerticalAlignment="Center" Margin="4,3"
                      ToolTip="{DynamicResource Screen.MonitorTip}"/>
            <Button x:Name="StartButton" Content="{DynamicResource Screen.Start}" Click="StartButton_Click"
                    FontSize="14" FontWeight="SemiBold" Padding="16,7" Margin="8,3,2,3"
                    ToolTip="{DynamicResource Screen.StartTip}"/>
            <Button x:Name="PassButton" Content="{DynamicResource Screen.Pass}" Margin="8,3,2,3" Click="PassButton_Click"
                    ToolTip="{DynamicResource Screen.PassTip}"/>
            <CheckBox x:Name="DeadPixelCheck" Content="{DynamicResource Screen.DeadFound}" Margin="16,0,0,0" VerticalAlignment="Center"
                      ToolTip="{DynamicResource Screen.DeadFoundTip}"/>
        </WrapPanel>

        <TextBlock x:Name="TestingHint" Text="" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>

        <!-- 使用说明（操作方式以这里为准：任意键/单击切换，Esc 退出） -->
        <TextBlock Text="{DynamicResource Screen.Instructions}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" Margin="0,4"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
