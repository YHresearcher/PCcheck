<UserControl x:Class="YanJi.Plugin.ScreenDeadPixel.DeadPixelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <!-- 状态行：通过后变绿 -->
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Trạng thái test:" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="Chưa test" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 操作行：显示器选择 + 开始测试 + 确认通过 -->
        <WrapPanel Orientation="Horizontal" Margin="0,8" VerticalAlignment="Center">
            <TextBlock Text="Màn hình:" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonitorBox" Width="340" VerticalAlignment="Center" Margin="4,3"
                      ToolTip="Chọn màn hình cần soi điểm chết (nhiều màn hình thì test từng cái một)"/>
            <Button x:Name="StartButton" Content="Bắt đầu test" Click="StartButton_Click"
                    FontSize="14" FontWeight="SemiBold" Padding="16,7" Margin="8,3,2,3"
                    ToolTip="Mở cửa sổ toàn màn hình với màu trơn trên màn hình đã chọn: trắng → đỏ → xanh lá → xanh dương → đen, xoay vòng"/>
            <Button x:Name="PassButton" Content="Xác nhận không lỗi, cho qua" Margin="8,3,2,3" Click="PassButton_Click"
                    ToolTip="Soi đủ các màu trơn, không thấy điểm chết, điểm sáng hay điểm tối rồi mới bấm"/>
            <CheckBox x:Name="DeadPixelCheck" Content="Phát hiện điểm chết / điểm sáng" Margin="16,0,0,0" VerticalAlignment="Center"
                      ToolTip="Tick khi soi thấy điểm chết, điểm sáng hay điểm tối — bấm cho qua vẫn ghi nhận lỗi vào kết luận (cảnh báo, thương lượng giá), không phải là 'không lỗi'"/>
        </WrapPanel>

        <TextBlock x:Name="TestingHint" Text="" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>

        <!-- 使用说明（操作方式以这里为准：任意键/单击切换，Esc 退出） -->
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" Margin="0,4">
Cách làm: bấm “Bắt đầu test”, màn hình đã chọn sẽ chuyển sang chế độ toàn màn hình với màu trơn (trắng → đỏ → xanh lá → xanh dương → đen, xoay vòng).
Bấm phím bất kỳ hoặc nhấp chuột trái = chuyển sang màu tiếp theo; bấm Esc = thoát toàn màn hình, quay lại trang này.
Soi kỹ toàn màn hình ở từng màu: điểm chết (lúc nào cũng đen), điểm sáng (lúc nào cũng sáng/trắng), điểm tối (màu lệch) — có lỗi là sẽ lộ ra ở một màu nào đó.
Nhiều màn hình thì test từng cái một; soi xong hết, không thấy lỗi thì bấm “Xác nhận không lỗi, cho qua”.
        </TextBlock>
    </StackPanel>
    </ScrollViewer>
</UserControl>
