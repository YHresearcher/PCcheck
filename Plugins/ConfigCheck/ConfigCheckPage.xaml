<UserControl x:Class="YanJi.Plugin.ConfigCheck.ConfigCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Thẻ nhóm phần cứng dùng chung cho mọi tab (项目 = 值 两列；Details 非空时带「详细信息」折叠区).
             Tab nào cũng dùng đúng 1 template này, để CPU / Memory / Storage / Graphics / Khác
             hiển thị cùng 1 kiểu, không phải viết lại 5 lần. -->
        <DataTemplate x:Key="GroupCardTemplate">
            <Border Style="{StaticResource CardBorder}" Width="Auto" Margin="0,0,0,12" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                    <ItemsControl ItemsSource="{Binding Entries}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Chi tiết" Style="{StaticResource DetailsExpander}">
                        <ItemsControl ItemsSource="{Binding Details}" Margin="14,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề khu vực Thông tin phần cứng: số liệu thô kiểu CPU-Z, không phải kết luận.
             Kết luận (Đạt / Cảnh báo / Chặn) ở trang Sức khỏe và Tổng kết, không ở đây. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Thông tin phần cứng" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Số liệu thô kiểu CPU-Z — chỉ để xem và đối chiếu, không phải kết luận. Kết luận ổ / sạc ở trang Sức khỏe và Tổng kết."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <!-- Thẻ chung Hãng / Model / S/N máy (1 chỗ, ngay dưới tiêu đề, khỏi phải
                 chui vào tab Khác tìm trong nhóm Máy & Mainboard). Giá trị lấy từ nhóm
                 Máy & Mainboard của lần thu thập gần nhất (SMBIOS thô); thu thập lại
                 thì thẻ này cập nhật theo. Chưa thu thập thì hiện "Chưa thu thập",
                 SMBIOS không đọc được thì hiện "Không đọc được", không bịa số. -->
            <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Hãng" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="BrandText" Text="Chưa thu thập" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Model" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="ModelText" Text="Chưa thu thập" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="S/N máy" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="SerialText" Text="Chưa thu thập" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 状态行：通过后变绿 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
            <TextBlock Text="Trạng thái đối chiếu:" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="Chờ đối chiếu" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 操作行（进入页面即自动检测，这里只保留手动重新检测） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
            <Button x:Name="RunButton" Content="Kiểm tra lại"
                    FontSize="14" FontWeight="SemiBold" Padding="16,7" Click="RunButton_Click"
                    ToolTip="Thu thập lại thông tin CPU / Card màn hình / RAM / Ổ / Màn hình / Pin (sẽ xóa trạng thái đã cho qua)"/>
            <Button x:Name="PassButton" Content="Xác nhận đúng, cho qua" IsEnabled="False"
                    Margin="8,3,2,3" Click="PassButton_Click"
                    ToolTip="Đối chiếu từng mục bên dưới với cấu hình đơn hàng rồi mới bấm"/>
        </StackPanel>

        <!-- 进度行 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <ProgressBar x:Name="DetectProgress" Height="10" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="PhaseText" Text="Chưa đối chiếu" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Kết quả: tab kiểu CPU-Z. Ánh xạ nhóm thu thập -> tab (xem SetTabGroups trong
             code-behind): CPU -> CPU, RAM -> Memory, Ổ -> Storage, Card màn hình -> Graphics,
             còn lại (Card mạng / Màn hình / Pin / nhóm mới sau này) -> Khác. Nhóm mới không
             bị mất vì luôn rơi vào tab Khác, không bị lọc bỏ. -->
        <!-- Hình viên pin thể hiện độ chai (thay cho việc chỉ đọc chữ "Độ chai X %"
             trong nhóm Pin ở tab Khác): mức đầy = dung lượng còn lại, màu theo mốc
             chai (<20% xanh, 20–<40% cam, ≥40% đỏ). Viên pin chỉ rộng 1/3 thẻ,
             chữ nằm bên phải; hiệu ứng 3D bằng gradient + bóng mờ + vệt bóng.
             Chỉ hiện khi đọc được % chai; máy không pin / không đọc được thì ẩn. -->
        <Border x:Name="BatteryCard" Grid.Row="4" Style="{StaticResource CardBorder}"
                Margin="0,0,0,12" Padding="14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="🔋  Pin — độ chai" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Height="40" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                                Background="{DynamicResource SurfaceBgBrush}"
                                CornerRadius="6" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BatteryFillColumn" Width="100*"/>
                                    <ColumnDefinition x:Name="BatteryEmptyColumn" Width="0*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="BatteryFill" Grid.Column="0" RadiusX="3" RadiusY="3"/>
                                <Rectangle Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="12"
                                           Margin="2,2,2,0" Fill="White" Opacity="0.25" RadiusX="3" RadiusY="3"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"
                                CornerRadius="0,4,4,0" Margin="0,12,0,12"/>
                    </Grid>
                    <TextBlock Grid.Column="1" x:Name="BatteryNoteText" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="5">
            <TabItem Header="CPU">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CpuHost" ItemTemplate="{StaticResource GroupCardTemplate}"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Memory">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MemoryHost" ItemTemplate="{StaticResource GroupCardTemplate}"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Storage">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StorageHost" ItemTemplate="{StaticResource GroupCardTemplate}"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Graphics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GraphicsHost" ItemTemplate="{StaticResource GroupCardTemplate}"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Khác">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="OtherHost" ItemTemplate="{StaticResource GroupCardTemplate}"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
