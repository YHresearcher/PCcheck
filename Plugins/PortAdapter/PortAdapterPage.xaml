<UserControl x:Class="YanJi.Plugin.PortAdapter.PortAdapterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Trạng thái: qua thì xanh lá (theo quy ước các module khác) -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="{DynamicResource Ports.StatusLabel}" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Ports.StatusNotTested}" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8" VerticalAlignment="Center">
                <Button x:Name="RescanButton" Content="{DynamicResource Ports.Rescan}" Click="RescanButton_Click"
                        Padding="12,4" Margin="0,3,8,3"
                        ToolTip="{DynamicResource Ports.RescanTip}"/>
                <Button x:Name="AdapterTestButton" Content="{DynamicResource Ports.ChargerTest}" Click="AdapterTestButton_Click"
                        FontSize="14" FontWeight="SemiBold" Padding="16,7" Margin="0,3,8,3"
                        ToolTip="{DynamicResource Ports.ChargerTestTip}"/>
                <Button x:Name="PassButton" Content="{DynamicResource Ports.Pass}" Click="PassButton_Click"
                        Margin="0,3,2,3"
                        ToolTip="{DynamicResource Ports.PassTip}"/>
            </StackPanel>

            <TextBlock x:Name="TestingHint" Text="" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>

            <!-- ═══ Sạc / Adapter ═══ -->
            <TextBlock Text="{DynamicResource Ports.AdapterHeading}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBlock x:Name="AdapterStatusText" Text="{DynamicResource Ports.AdapterStatusNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="AdapterInstantText" Text="{DynamicResource Ports.AdapterSnapshotNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="AdapterVoltageText" Text="{DynamicResource Ports.VoltageNotTested}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="AdapterPowerText" Text="{DynamicResource Ports.PowerNotTested}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="AdapterBatteryText" Text="{DynamicResource Ports.BatteryNotTested}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="AdapterHealthText" Text="{DynamicResource Ports.HealthNotTested}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="AdapterIssuesText" Text="" TextWrapping="Wrap" Margin="0,2"
                       Foreground="{DynamicResource ErrorBrush}"/>
            <TextBlock Text="{DynamicResource Ports.AdapterNote}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" Margin="0,4"/>

            <!-- ═══ Cổng phát hiện tự động ═══ -->
            <TextBlock Text="{DynamicResource Ports.AutoHeading}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBlock x:Name="UsbControllersText" Text="{DynamicResource Ports.UsbControllersNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="RootHubsText" Text="{DynamicResource Ports.RootHubsNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="UsbCText" Text="{DynamicResource Ports.UsbCNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="UsbPdText" Text="{DynamicResource Ports.UsbPdNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="EthernetText" Text="{DynamicResource Ports.EthernetNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock x:Name="MonitorText" Text="{DynamicResource Ports.MonitorNotScanned}" TextWrapping="Wrap" Margin="0,2"/>
            <TextBlock Text="{DynamicResource Ports.AutoNote}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" Margin="0,4"/>

            <!-- ═══ Kiểm tra bằng mắt ═══ -->
            <TextBlock Text="{DynamicResource Ports.ManualHeading}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <CheckBox x:Name="ChkHdmi" Content="{DynamicResource Ports.CheckHdmi}" Margin="0,2"/>
            <CheckBox x:Name="ChkVga" Content="{DynamicResource Ports.CheckVga}" Margin="0,2"/>
            <CheckBox x:Name="ChkRj45" Content="{DynamicResource Ports.CheckRj45}" Margin="0,2"/>
            <CheckBox x:Name="ChkUsbA" Content="{DynamicResource Ports.CheckUsbA}" Margin="0,2"/>
            <CheckBox x:Name="ChkUsbC" Content="{DynamicResource Ports.CheckUsbC}" Margin="0,2"/>
            <CheckBox x:Name="ChkChargerPlug" Content="{DynamicResource Ports.CheckChargerPlug}" Margin="0,2"/>

            <!-- Nhật ký -->
            <TextBlock Text="{DynamicResource Ports.LogHeading}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <Border CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         Height="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
